    {
      "id": "blink",
      "name": "Blink and heartbeat",
      "url": "https://esp32bench.dev/projects/blink",
      "level": "Starter",
      "minutes": 5,
      "tags": [
        "no-parts"
      ],
      "summary": "Toggle the LED on GPIO 2 and print a tick every second. The first thing to flash on any new board.",
      "firmware": "sketch",
      "libraries": [
        "Adafruit NeoPixel"
      ],
      "install": [
        {
          "library": "Adafruit NeoPixel",
          "registry": "adafruit/Adafruit NeoPixel"
        }
      ],
      "baud": 115200,
      "needs": [],
      "parts": [
        {
          "quantity": 1,
          "name": "ESP32 dev board",
          "link": "https://www.amazon.com/dp/B08D5ZD528"
        },
        {
          "quantity": 1,
          "name": "LED and 220 Ω resistor, only if your board has no LED on GPIO 2"
        }
      ],
      "expect": {
        "patterns": [
          "tick \\d+ ms"
        ],
        "seconds": 8,
        "needs": "none"
      },
      "builds": [
        {
          "board": "esp32",
          "pins": [
            "2"
          ],
          "wiring": [
            {
              "from": "LED anode, through 220 Ω",
              "to": "GPIO 2",
              "note": "Skip if your board has an onboard LED"
            },
            {
              "from": "LED cathode",
              "to": "GND",
              "note": ""
            }
          ],
          "code": "// Arduino sketch for esp32, with this board's pins filled in.\nvoid setup() {}\nvoid loop() {}\n",
          "sample": [
            "ets Jul 29 2019 12:21:46",
            "rst:0x1 (POWERON_RESET),boot:0x13 (SPI_FAST_FLASH_BOOT)",
            "tick 1000 ms",
            "tick 2000 ms",
            "tick 3000 ms",
            "tick 4000 ms"
          ]
        },
        {
          "board": "esp32-doit",
          "pins": [
            "2"
          ],
          "wiring": [
            {
              "from": "LED anode, through 220 Ω",
              "to": "GPIO 2",
              "note": "Skip if your board has an onboard LED"
            },
            {
              "from": "LED cathode",
              "to": "GND",
              "note": ""
            }
          ],
          "code": "// Arduino sketch for esp32-doit, with this board's pins filled in.\nvoid setup() {}\nvoid loop() {}\n",
          "sample": [
            "ets Jul 29 2019 12:21:46",
            "rst:0x1 (POWERON_RESET),boot:0x13 (SPI_FAST_FLASH_BOOT)",
            "tick 1000 ms",
            "tick 2000 ms",
            "tick 3000 ms",
            "tick 4000 ms"
          ]
        }
      ]
