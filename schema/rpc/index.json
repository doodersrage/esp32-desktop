{
  "protocol": "0.7.0",
  "description": "JSON-RPC methods between the esp32bench UI and core. See docs/rpc.md.",
  "methods": [
    "build.start",
    "core.hello",
    "core.unsubscribe",
    "device.list",
    "device.watch",
    "job.cancel",
    "library.get",
    "library.list",
    "library.refresh",
    "serial.open",
    "serial.reset",
    "serial.write",
    "toolchain.install",
    "toolchain.status"
  ],
  "events": [
    "build.finished",
    "build.log",
    "device.changed",
    "library.refreshed",
    "serial.closed",
    "serial.data",
    "toolchain.finished",
    "toolchain.progress"
  ]
}
