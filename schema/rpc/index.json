{
  "protocol": "0.9.0",
  "description": "JSON-RPC methods between the esp32bench UI and core. See docs/rpc.md.",
  "methods": [
    "board.erase",
    "board.flash",
    "board.inspect",
    "build.start",
    "core.hello",
    "core.unsubscribe",
    "device.list",
    "device.watch",
    "job.cancel",
    "library.get",
    "library.list",
    "library.refresh",
    "serial.open",
    "serial.reset",
    "serial.write",
    "sim.reset",
    "sim.start",
    "sim.write",
    "toolchain.install",
    "toolchain.status"
  ],
  "events": [
    "board.finished",
    "board.progress",
    "build.finished",
    "build.log",
    "device.changed",
    "library.refreshed",
    "serial.closed",
    "serial.data",
    "sim.exited",
    "sim.output",
    "toolchain.finished",
    "toolchain.progress"
  ]
}
