{
  "event": "build.log",
  "description": "One line printed by arduino-cli during a build.start job.",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "subscription",
      "stream",
      "line"
    ],
    "additionalProperties": false,
    "properties": {
      "subscription": {
        "type": "integer",
        "minimum": 1,
        "description": "The job id."
      },
      "stream": {
        "enum": [
          "stdout",
          "stderr"
        ]
      },
      "line": {
        "type": "string"
      },
      "explain": {
        "type": "array",
        "maxItems": 64,
        "description": "Plain-language explanations of lines this chunk completed (the manifest's explain rules: a crash, a reset reason, an upload error), each key once per run. Absent when there are none.",
        "items": {
          "type": "object",
          "required": [
            "key",
            "text",
            "level"
          ],
          "additionalProperties": false,
          "properties": {
            "key": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "level": {
              "enum": [
                "problem",
                "info"
              ]
            },
            "url": {
              "type": "string",
              "description": "The site's page about it."
            }
          }
        }
      },
      "level": {
        "enum": [
          "error",
          "warning"
        ],
        "description": "Since protocol 0.27: the line is a compiler or tool error or warning."
      }
    }
  },
  "examples": [
    {
      "params": {
        "subscription": 7,
        "stream": "stdout",
        "line": "Sketch uses 254756 bytes (19%) of program storage space."
      }
    }
  ]
}
