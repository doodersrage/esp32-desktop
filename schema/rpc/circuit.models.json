{
  "method": "circuit.models",
  "description": "The kinds of part the app can place (schema/part-model), built into the program: their pins, I2C addresses, properties, controls and state. Scripts are not included.",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "models"
    ],
    "additionalProperties": false,
    "properties": {
      "models": {
        "type": "array",
        "items": {
          "description": "One kind of virtual part: a description plus a Rhai script (docs/parts.md). Version 1.x.",
          "type": "object",
          "required": [
            "schemaVersion",
            "id",
            "name",
            "look",
            "script"
          ],
          "additionalProperties": false,
          "properties": {
            "schemaVersion": {
              "type": "string",
              "pattern": "^1\\.[0-9]+\\.[0-9]+$"
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9-]{1,32}$"
            },
            "name": {
              "type": "string",
              "maxLength": 40
            },
            "look": {
              "enum": [
                "led",
                "button",
                "switch",
                "rgb-led",
                "display",
                "box"
              ],
              "description": "How the app draws it."
            },
            "pins": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,15}$"
              },
              "maxItems": 16,
              "uniqueItems": true,
              "description": "Named connections to GPIOs."
            },
            "i2c": {
              "type": "object",
              "required": [
                "addresses"
              ],
              "additionalProperties": false,
              "properties": {
                "addresses": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "integer",
                    "minimum": 8,
                    "maximum": 119
                  }
                }
              }
            },
            "display": {
              "type": "object",
              "required": [
                "width",
                "height"
              ],
              "additionalProperties": false,
              "properties": {
                "width": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 512
                },
                "height": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 512
                }
              }
            },
            "props": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "required": [
                  "type",
                  "default",
                  "label"
                ],
                "additionalProperties": false,
                "properties": {
                  "type": {
                    "enum": [
                      "bool",
                      "int",
                      "number"
                    ]
                  },
                  "default": {},
                  "label": {
                    "type": "string"
                  },
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  }
                }
              }
            },
            "controls": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "type",
                  "label"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "type": {
                    "enum": [
                      "momentary",
                      "toggle",
                      "slider"
                    ]
                  },
                  "label": {
                    "type": "string"
                  },
                  "min": {
                    "type": "number"
                  },
                  "max": {
                    "type": "number"
                  },
                  "default": {
                    "type": "number"
                  },
                  "unit": {
                    "type": "string"
                  }
                }
              }
            },
            "state": {
              "type": "object",
              "description": "The state the app shows, with starting values."
            },
            "script": {
              "type": "string",
              "pattern": "^[a-z0-9-]+\\.rhai$"
            }
          }
        }
      }
    }
  },
  "errors": [],
  "examples": [
    {
      "params": {},
      "result": {
        "models": [
          {
            "schemaVersion": "1.0.0",
            "id": "led",
            "name": "LED",
            "look": "led",
            "pins": [
              "anode"
            ],
            "props": {
              "activeLow": {
                "type": "bool",
                "default": false,
                "label": "Wired to 3V3 (lit when the pin is low)"
              }
            },
            "state": {
              "on": false
            },
            "script": "led.rhai"
          }
        ]
      }
    }
  ]
}
