{
  "method": "debug.control",
  "description": "Run or step the debugged firmware: continue, next (step over), step (into), finish (out of the function), interrupt (pause), or since protocol 0.34 runTo, which runs to location through a temporary breakpoint (or stops at a breakpoint before it). The result comes at once; debug.running and debug.stopped follow.",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "subscription",
      "action"
    ],
    "additionalProperties": false,
    "properties": {
      "subscription": {
        "type": "integer",
        "minimum": 1
      },
      "action": {
        "enum": [
          "continue",
          "next",
          "step",
          "finish",
          "interrupt",
          "runTo"
        ]
      },
      "location": {
        "type": "string",
        "maxLength": 256,
        "description": "Since protocol 0.34, for runTo only: a function name or file:line."
      }
    }
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "errors": [
    -32602,
    -32000,
    -32005
  ],
  "examples": [
    {
      "params": {
        "subscription": 5,
        "action": "continue"
      },
      "result": {}
    },
    {
      "params": {
        "subscription": 5,
        "action": "runTo",
        "location": "blink.ino:12"
      },
      "result": {}
    }
  ]
}
