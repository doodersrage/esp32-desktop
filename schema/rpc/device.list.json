{
  "method": "device.list",
  "description": "List serial ports that could be ESP32 boards, with a guess at the chip from the USB IDs.",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "all": {
        "type": "boolean",
        "description": "Include ports that are not USB, such as built-in /dev/ttyS*. Default false."
      }
    },
    "additionalProperties": false
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "ports"
    ],
    "properties": {
      "ports": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path",
            "kind",
            "bridge",
            "chips",
            "access"
          ],
          "properties": {
            "path": {
              "type": "string",
              "description": "Device node, e.g. /dev/ttyUSB0."
            },
            "kind": {
              "enum": [
                "usb",
                "pci",
                "bluetooth",
                "other"
              ]
            },
            "usb": {
              "type": "object",
              "required": [
                "vid",
                "pid"
              ],
              "properties": {
                "vid": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                },
                "pid": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                },
                "serial": {
                  "type": "string"
                },
                "manufacturer": {
                  "type": "string"
                },
                "product": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "bridge": {
              "description": "What the USB device is. null when unknown.",
              "enum": [
                "cp210x",
                "ch340",
                "ch9102",
                "ftdi",
                "pl2303",
                "usb-serial-jtag",
                "usb-cdc",
                null
              ]
            },
            "chips": {
              "description": "Chips this port could belong to, as esp32bench.dev chip ids. Empty when the USB IDs do not say.",
              "type": "array",
              "items": {
                "enum": [
                  "esp32",
                  "esp32s2",
                  "esp32s3",
                  "esp32c3",
                  "esp32c6"
                ]
              }
            },
            "access": {
              "description": "Whether this user can open the port. 'denied' usually means the udev rule or the uucp group is missing.",
              "enum": [
                "ok",
                "denied"
              ]
            },
            "identified": {
              "type": "boolean",
              "description": "Since protocol 0.26: true when chips is the chip a board check (board.inspect) found behind this adapter before, remembered by its USB IDs and serial number. Absent otherwise."
            },
            "inspected": {
              "type": "object",
              "required": [
                "at"
              ],
              "additionalProperties": false,
              "description": "Since protocol 0.38: what board.inspect last found on this adapter's board (kept with the chip, for adapters with a serial number).",
              "properties": {
                "flashBytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "mac": {
                  "type": "string"
                },
                "revision": {
                  "type": "string"
                },
                "at": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "When, in seconds since 1970."
                }
              }
            },
            "flashed": {
              "type": "object",
              "required": [
                "project",
                "board",
                "at"
              ],
              "additionalProperties": false,
              "description": "Since protocol 0.41: the build last flashed from the app to this adapter's board (adapters with a serial number).",
              "properties": {
                "project": {
                  "type": "string"
                },
                "board": {
                  "type": "string"
                },
                "at": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "When, in seconds since 1970."
                }
              }
            }
          },
          "additionalProperties": false
        }
      },
      "advice": {
        "description": "Why a board may be missing or unusable, for the app to explain in its own words. Empty when there is nothing to say. Kinds: data-cable (no port at all; a charge-only cable shows none), install-driver (macOS and Windows: a CH340 or CP210x board may need its maker's driver), bridge-without-port (a USB serial chip is plugged in but no driver gave it a port; on Linux often brltty), serial-access (a port this user may not open). Since protocol 0.25.",
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "data-cable",
                "install-driver",
                "bridge-without-port",
                "serial-access"
              ]
            },
            "bridge": {
              "description": "bridge-without-port: which chip.",
              "enum": [
                "cp210x",
                "ch340",
                "ch9102",
                "ftdi",
                "pl2303",
                "usb-serial-jtag"
              ]
            }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  },
  "errors": [],
  "examples": [
    {
      "params": {},
      "result": {
        "ports": [],
        "advice": [
          {
            "kind": "data-cable"
          },
          {
            "kind": "install-driver"
          }
        ]
      }
    },
    {
      "params": {
        "all": false
      },
      "result": {
        "ports": [
          {
            "path": "/dev/ttyACM0",
            "kind": "usb",
            "usb": {
              "vid": 12346,
              "pid": 4097,
              "serial": "F4:12:FA:00:11:22",
              "manufacturer": "Espressif",
              "product": "USB JTAG/serial debug unit"
            },
            "bridge": "usb-serial-jtag",
            "chips": [
              "esp32s3",
              "esp32c3",
              "esp32c6"
            ],
            "access": "ok"
          },
          {
            "path": "/dev/ttyUSB0",
            "kind": "usb",
            "usb": {
              "vid": 4292,
              "pid": 60000,
              "product": "CP2102N USB to UART Bridge Controller"
            },
            "bridge": "cp210x",
            "chips": [],
            "access": "denied"
          }
        ],
        "advice": [
          {
            "kind": "serial-access"
          }
        ]
      }
    }
  ]
}
