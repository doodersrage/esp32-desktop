{
  "method": "debug.break",
  "description": "Set a breakpoint in a simulator started with debug: true. The location is a function name or file:line. Breakpoints are hardware breakpoints (code runs from flash), and chips have only a few of them, so setting one can fail when they are all in use.",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "subscription",
      "location"
    ],
    "additionalProperties": false,
    "properties": {
      "subscription": {
        "type": "integer",
        "minimum": 1
      },
      "location": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "pattern": "^[A-Za-z0-9_:./][A-Za-z0-9_:./-]*$"
      }
    }
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "breakpoint"
    ],
    "additionalProperties": false,
    "properties": {
      "breakpoint": {
        "type": "object",
        "required": [
          "addr",
          "number"
        ],
        "additionalProperties": false,
        "properties": {
          "addr": {
            "type": "string"
          },
          "func": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "line": {
            "type": "integer",
            "minimum": 1
          },
          "number": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  },
  "errors": [
    -32602,
    -32000,
    -32005
  ],
  "examples": [
    {
      "params": {
        "subscription": 5,
        "location": "setup"
      },
      "result": {
        "breakpoint": {
          "number": 1,
          "addr": "0x400d1a2c",
          "func": "setup",
          "file": "/home/me/.local/share/esp32bench/builds/blink/esp32/sketch/blink.ino",
          "line": 4
        }
      }
    }
  ]
}
