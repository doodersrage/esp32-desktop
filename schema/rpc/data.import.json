{
  "method": "data.import",
  "description": "Since protocol 0.40: a settings file (data.export's) merged in: what it has replaces what is here for the same project (and board), each entry checked as the method that keeps it checks it. Entries that do not pass are left out and counted (skipped).",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "path"
    ],
    "additionalProperties": false,
    "properties": {
      "path": {
        "type": "string"
      }
    }
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "counts",
      "skipped"
    ],
    "additionalProperties": false,
    "properties": {
      "counts": {
        "type": "object",
        "required": [
          "breakpoints",
          "watches",
          "commands",
          "starred",
          "notes",
          "circuits"
        ],
        "additionalProperties": false,
        "properties": {
          "breakpoints": {
            "type": "integer",
            "minimum": 0
          },
          "watches": {
            "type": "integer",
            "minimum": 0
          },
          "commands": {
            "type": "integer",
            "minimum": 0
          },
          "starred": {
            "type": "integer",
            "minimum": 0
          },
          "notes": {
            "type": "integer",
            "minimum": 0
          },
          "circuits": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "skipped": {
        "type": "integer",
        "minimum": 0
      }
    }
  },
  "errors": [
    -32602,
    -32000
  ],
  "examples": [
    {
      "params": {
        "path": "/home/me/esp32bench-settings.json"
      },
      "result": {
        "counts": {
          "breakpoints": 2,
          "watches": 1,
          "commands": 3,
          "starred": 5,
          "notes": 2,
          "circuits": 4
        },
        "skipped": 0
      }
    }
  ]
}
