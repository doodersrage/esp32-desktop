{
  "method": "serial.write",
  "description": "Send bytes to a port this connection opened.",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "subscription",
      "data"
    ],
    "additionalProperties": false,
    "properties": {
      "subscription": {
        "type": "integer",
        "minimum": 1
      },
      "data": {
        "type": "string",
        "contentEncoding": "base64",
        "description": "Bytes to send, base64."
      }
    }
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "errors": [
    -32000,
    -32005
  ],
  "examples": [
    {
      "params": {
        "subscription": 3,
        "data": "aGVsbG8K"
      },
      "result": {}
    }
  ]
}
