{
  "method": "library.get",
  "description": "One project from the cached library, as in the manifest, with the board records its builds refer to.",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "id"
    ],
    "additionalProperties": false,
    "properties": {
      "id": {
        "type": "string"
      }
    }
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "project",
      "boards"
    ],
    "additionalProperties": false,
    "properties": {
      "project": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "url",
          "level",
          "minutes",
          "tags",
          "summary",
          "firmware",
          "libraries",
          "baud",
          "needs",
          "parts",
          "builds"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "level": {
            "enum": [
              "Starter",
              "Intermediate"
            ]
          },
          "minutes": {
            "type": "integer",
            "minimum": 0
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "added": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "summary": {
            "type": "string"
          },
          "firmware": {
            "enum": [
              "sketch",
              "prebuilt"
            ]
          },
          "sourceUrl": {
            "type": "string"
          },
          "libraries": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Arduino libraries to install before building."
          },
          "baud": {
            "type": "integer",
            "minimum": 1
          },
          "needs": {
            "type": "array",
            "items": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Parts beyond the board; each inner list is a set of alternatives."
          },
          "parts": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "quantity",
                "name"
              ],
              "additionalProperties": false,
              "properties": {
                "quantity": {
                  "type": "integer",
                  "minimum": 1
                },
                "name": {
                  "type": "string"
                },
                "link": {
                  "type": "string"
                }
              }
            }
          },
          "settings": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "key",
                "label",
                "kind"
              ],
              "additionalProperties": false,
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "label": {
                  "type": "string"
                },
                "kind": {
                  "enum": [
                    "text",
                    "password",
                    "url",
                    "number"
                  ]
                },
                "hint": {
                  "type": "string"
                },
                "required": {
                  "type": "boolean"
                }
              }
            }
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "open": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verified": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "board",
                "what"
              ],
              "additionalProperties": false,
              "properties": {
                "board": {
                  "type": "string"
                },
                "what": {
                  "type": "string"
                },
                "when": {
                  "type": "string"
                }
              }
            }
          },
          "expect": {
            "type": "object",
            "required": [
              "patterns",
              "seconds",
              "needs"
            ],
            "additionalProperties": false,
            "properties": {
              "patterns": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "seconds": {
                "type": "integer",
                "minimum": 1
              },
              "needs": {
                "enum": [
                  "none",
                  "wifi",
                  "parts"
                ]
              },
              "notes": {
                "type": "string"
              }
            }
          },
          "extra": {
            "type": "object",
            "required": [
              "title",
              "board",
              "code"
            ],
            "additionalProperties": false,
            "properties": {
              "title": {
                "type": "string"
              },
              "board": {
                "type": "string"
              },
              "code": {
                "type": "string"
              }
            }
          },
          "builds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "board",
                "pins",
                "wiring",
                "sample"
              ],
              "additionalProperties": false,
              "properties": {
                "board": {
                  "type": "string"
                },
                "pins": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "wiring": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "from",
                      "to",
                      "note"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "from": {
                        "type": "string"
                      },
                      "to": {
                        "type": "string"
                      },
                      "note": {
                        "type": "string"
                      }
                    }
                  }
                },
                "code": {
                  "type": "string",
                  "description": "Arduino sketch with this board's values filled in. Absent for prebuilt firmware."
                },
                "sample": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Lines the firmware prints when it works."
                }
              }
            }
          }
        }
      },
      "boards": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "id",
            "name",
            "short",
            "chip",
            "arduinoBoard"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "short": {
              "type": "string"
            },
            "chip": {
              "enum": [
                "esp32",
                "esp32s2",
                "esp32s3",
                "esp32c3",
                "esp32c6"
              ]
            },
            "arduinoBoard": {
              "type": "string",
              "description": "Board name as picked in the Arduino IDE."
            },
            "variantOf": {
              "type": "string",
              "description": "Board id this one is a variant of (same chip and GPIO numbers)."
            },
            "buildAs": {
              "type": "string",
              "description": "Board id whose firmware this board runs."
            }
          }
        }
      }
    }
  },
  "errors": [
    -32000
  ],
  "examples": [
    {
      "params": {
        "id": "blink"
      },
      "result": {
        "project": {
          "id": "blink",
          "name": "Blink and heartbeat",
          "url": "https://esp32bench.dev/projects/blink",
          "level": "Starter",
          "minutes": 5,
          "tags": [
            "no-parts"
          ],
          "summary": "Toggle the LED on GPIO 2 and print a tick every second. The first thing to flash on any new board.",
          "firmware": "sketch",
          "libraries": [],
          "baud": 115200,
          "needs": [],
          "parts": [
            {
              "quantity": 1,
              "name": "ESP32 dev board",
              "link": "https://www.amazon.com/dp/B08D5ZD528"
            },
            {
              "quantity": 1,
              "name": "LED and 220 \u03a9 resistor, only if your board has no LED on GPIO 2"
            }
          ],
          "expect": {
            "patterns": [
              "tick \\d+ ms"
            ],
            "seconds": 8,
            "needs": "none"
          },
          "builds": [
            {
              "board": "esp32",
              "pins": [
                "2"
              ],
              "wiring": [
                {
                  "from": "LED anode, through 220 \u03a9",
                  "to": "GPIO 2",
                  "note": "Skip if your board has an onboard LED"
                },
                {
                  "from": "LED cathode",
                  "to": "GND",
                  "note": ""
                }
              ],
              "code": "// Arduino sketch for esp32, with this board's pins filled in.\nvoid setup() {}\nvoid loop() {}\n",
              "sample": [
                "ets Jul 29 2019 12:21:46",
                "rst:0x1 (POWERON_RESET),boot:0x13 (SPI_FAST_FLASH_BOOT)",
                "tick 1000 ms",
                "tick 2000 ms",
                "tick 3000 ms",
                "tick 4000 ms"
              ]
            },
            {
              "board": "esp32-doit",
              "pins": [
                "2"
              ],
              "wiring": [
                {
                  "from": "LED anode, through 220 \u03a9",
                  "to": "GPIO 2",
                  "note": "Skip if your board has an onboard LED"
                },
                {
                  "from": "LED cathode",
                  "to": "GND",
                  "note": ""
                }
              ],
              "code": "// Arduino sketch for esp32-doit, with this board's pins filled in.\nvoid setup() {}\nvoid loop() {}\n",
              "sample": [
                "ets Jul 29 2019 12:21:46",
                "rst:0x1 (POWERON_RESET),boot:0x13 (SPI_FAST_FLASH_BOOT)",
                "tick 1000 ms",
                "tick 2000 ms",
                "tick 3000 ms",
                "tick 4000 ms"
              ]
            }
          ]
        },
        "boards": [
          {
            "id": "esp32",
            "name": "ESP32-DevKitC V4, 38 pin",
            "short": "ESP32",
            "chip": "esp32",
            "arduinoBoard": "ESP32 Dev Module"
          },
          {
            "id": "esp32-doit",
            "name": "ESP32 DevKit V1 (DOIT), 30 pin",
            "short": "DOIT 30",
            "chip": "esp32",
            "arduinoBoard": "DOIT ESP32 DEVKIT V1 (or ESP32 Dev Module)",
            "variantOf": "esp32",
            "buildAs": "esp32"
          }
        ]
      }
    }
  ]
}
