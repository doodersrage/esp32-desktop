{
  "method": "circuit.set",
  "description": "Save the virtual parts for a project's board, replacing what was there. Checked first against each part's model (circuit.models): unique ids, every pin connected to a real GPIO, known properties, I2C addresses the model allows, no two parts driving one pin, at most 32 parts. Saved as circuit 1.1; 1.0 files are still read. A running simulation keeps the parts it started with.",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "project",
      "board",
      "circuit"
    ],
    "additionalProperties": false,
    "properties": {
      "project": {
        "type": "string"
      },
      "board": {
        "type": "string"
      },
      "circuit": {
        "description": "Virtual parts placed on one project's board for the simulator. Version 1.x; 1.1 adds models beyond LED and button, several pins per part, I2C placement and properties, and still reads 1.0 files (`pin`, `activeLow`). Saved by the desktop app per project and board; designed so the project manifest can carry the same data later. Pins are GPIO numbers. Firmware-level: an LED is lit when its pin drives it; no electrical behaviour is modelled.",
        "type": "object",
        "required": [
          "schemaVersion",
          "parts"
        ],
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "type": "string",
            "pattern": "^1\\.[0-9]+\\.[0-9]+$"
          },
          "parts": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "required": [
                "id",
                "kind"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]{1,32}$",
                  "description": "Unique within the circuit."
                },
                "kind": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]{1,32}$",
                  "description": "A part model's id: led, button, switch, rgb-led, ... (schema/part-model)."
                },
                "pin": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 48,
                  "description": "The GPIO, for a model with one pin."
                },
                "activeLow": {
                  "type": "boolean",
                  "default": false,
                  "description": "Circuit 1.0's shorthand for props.activeLow. Still read; not written by 1.1."
                },
                "label": {
                  "type": "string",
                  "maxLength": 40
                },
                "pins": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 48
                  },
                  "description": "GPIOs by the model's pin names."
                },
                "i2c": {
                  "type": "object",
                  "required": [
                    "bus",
                    "address"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "bus": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1
                    },
                    "address": {
                      "type": "integer",
                      "minimum": 8,
                      "maximum": 119
                    }
                  }
                },
                "props": {
                  "type": "object",
                  "description": "Values for the model's properties."
                },
                "controls": {
                  "type": "object",
                  "description": "Where the part's sliders were left (1.2), by control name; applied when a simulation starts. Each must be a slider of the part's model, within its range.",
                  "additionalProperties": {
                    "type": "number"
                  },
                  "propertyNames": {
                    "pattern": "^[a-zA-Z0-9_-]{1,32}$"
                  }
                },
                "at": {
                  "type": "object",
                  "required": [
                    "x",
                    "y"
                  ],
                  "additionalProperties": false,
                  "description": "Where the app's canvas shows the part, once moved there (1.3). Only the drawing: the part works the same anywhere.",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {},
    "additionalProperties": false
  },
  "errors": [
    -32602,
    -32000
  ],
  "examples": [
    {
      "params": {
        "project": "blink",
        "board": "esp32",
        "circuit": {
          "schemaVersion": "1.1.0",
          "parts": [
            {
              "id": "status-led",
              "kind": "led",
              "pin": 2,
              "label": "Status LED"
            },
            {
              "id": "boot",
              "kind": "button",
              "pin": 0,
              "props": {
                "activeLow": true
              },
              "label": "BOOT button"
            },
            {
              "id": "mood",
              "kind": "rgb-led",
              "pins": {
                "red": 25,
                "green": 26,
                "blue": 27
              }
            },
            {
              "id": "mode",
              "kind": "switch",
              "pin": 4
            }
          ]
        }
      },
      "result": {}
    }
  ]
}
