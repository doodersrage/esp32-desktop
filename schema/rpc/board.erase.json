{
  "method": "board.erase",
  "description": "Erase the whole flash of a board, including saved settings. `confirm` must be true: the UI asks first. A job: board.progress, then board.finished.",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "port",
      "confirm"
    ],
    "additionalProperties": false,
    "properties": {
      "port": {
        "type": "string",
        "description": "A path from device.list."
      },
      "reset": {
        "enum": [
          "auto",
          "none"
        ],
        "description": "How to enter the bootloader. auto (default): the USB sequence for USB-Serial-JTAG boards, DTR/RTS otherwise. none: the chip is already in download mode."
      },
      "stub": {
        "type": "boolean",
        "description": "Use espflash's RAM stub (faster). Default true; the ROM loader alone also works."
      },
      "confirm": {
        "const": true
      }
    }
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "job"
    ],
    "additionalProperties": false,
    "properties": {
      "job": {
        "type": "integer",
        "minimum": 1
      }
    }
  },
  "errors": [
    -32000
  ],
  "events": [
    "board.progress",
    "board.finished"
  ],
  "examples": [
    {
      "params": {
        "port": "/dev/ttyACM0",
        "confirm": true
      },
      "result": {
        "job": 4
      }
    }
  ]
}
