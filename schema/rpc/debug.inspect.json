{
  "method": "debug.inspect",
  "description": "While the firmware is stopped: its call stack (innermost first, at most 32 frames) and its general registers in hex (pc, a0-a15 and a few specials on Xtensa; pc and x0-x31 by ABI name on RISC-V). Since protocol 0.36, with frame, of that stack frame (0 is where the firmware stopped, as frames lists them): its locals and registers, and expressions are evaluated there until the firmware runs again.",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "subscription"
    ],
    "additionalProperties": false,
    "properties": {
      "subscription": {
        "type": "integer",
        "minimum": 1
      },
      "frame": {
        "type": "integer",
        "minimum": 0,
        "maximum": 31
      }
    }
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "frames",
      "registers"
    ],
    "additionalProperties": false,
    "properties": {
      "frames": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "addr"
          ],
          "additionalProperties": false,
          "properties": {
            "addr": {
              "type": "string"
            },
            "func": {
              "type": "string"
            },
            "file": {
              "type": "string"
            },
            "line": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      },
      "registers": {
        "type": "array",
        "items": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "required": [
            "name",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "value": {
              "type": "string"
            }
          }
        }
      },
      "locals": {
        "type": "array",
        "maxItems": 64,
        "description": "Since protocol 0.32: the innermost frame's arguments and local variables, at most 64; empty where it has no debug information. value is absent for values GDB does not print simply (structs, arrays).",
        "items": {
          "type": "object",
          "required": [
            "name",
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "type": {
              "type": "string"
            },
            "arg": {
              "const": true,
              "description": "An argument of the function."
            },
            "value": {
              "type": "string"
            }
          }
        }
      },
      "frame": {
        "type": "integer",
        "minimum": 0,
        "description": "Since protocol 0.36: the frame shown."
      }
    }
  },
  "errors": [
    -32000,
    -32005
  ],
  "examples": [
    {
      "params": {
        "subscription": 5
      },
      "result": {
        "frames": [
          {
            "addr": "0x400d1a2f",
            "func": "loop",
            "file": "/home/me/blink/blink.ino",
            "line": 9
          }
        ],
        "registers": [
          {
            "name": "pc",
            "value": "0x400d1a2f"
          },
          {
            "name": "ar0",
            "value": "0x800d2b44"
          }
        ],
        "locals": [
          {
            "name": "pin",
            "type": "int",
            "arg": true,
            "value": "2"
          },
          {
            "name": "now",
            "type": "unsigned long",
            "value": "1500"
          },
          {
            "name": "reading",
            "type": "Reading"
          }
        ]
      }
    }
  ]
}
