{
  "event": "sim.pins",
  "description": "Pins of the simulation (sim.start's `pins`) that changed: the level the firmware drives, and whether the pin is an output. Batched: at most one event every 50 ms, with each changed pin's latest state, so fast toggling shows as its latest level. Outputs are reported for GPIO 0-31 only (a limit of the fork).",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "subscription",
      "pins"
    ],
    "additionalProperties": false,
    "properties": {
      "subscription": {
        "type": "integer",
        "minimum": 1
      },
      "pins": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "gpio"
          ],
          "additionalProperties": false,
          "properties": {
            "gpio": {
              "type": "integer",
              "minimum": 0,
              "maximum": 48
            },
            "level": {
              "type": "boolean"
            },
            "output": {
              "type": "boolean"
            },
            "rate": {
              "description": "Since protocol 0.33: how fast the pin toggles over the last two simulated seconds (hz, rising edges a second) and the share of that time it is high (high, 0 to 1); null once it no longer toggles. Sent when it changes, about twice a second at most.",
              "oneOf": [
                {
                  "type": "object",
                  "required": [
                    "hz",
                    "high"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "hz": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "high": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      }
    }
  },
  "examples": [
    {
      "params": {
        "subscription": 5,
        "pins": [
          {
            "gpio": 2,
            "level": true,
            "output": true
          }
        ]
      }
    },
    {
      "params": {
        "subscription": 3,
        "pins": [
          {
            "gpio": 2,
            "level": true,
            "output": true,
            "rate": {
              "hz": 1.0,
              "high": 0.5
            }
          }
        ]
      }
    }
  ]
}
