{
  "method": "sim.pulsePin",
  "description": "Since protocol 0.37: drive one of the simulation's pins to level for ms milliseconds, then back: a button pressed and let go, timed by the core. A pulse on a pin already pulsing replaces it.",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "subscription",
      "gpio",
      "level",
      "ms"
    ],
    "additionalProperties": false,
    "properties": {
      "subscription": {
        "type": "integer",
        "minimum": 1
      },
      "gpio": {
        "type": "integer",
        "minimum": 0,
        "maximum": 48
      },
      "level": {
        "type": "boolean"
      },
      "ms": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10000
      }
    }
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [],
    "additionalProperties": false,
    "properties": {}
  },
  "errors": [
    -32602,
    -32000,
    -32005
  ],
  "examples": [
    {
      "params": {
        "subscription": 5,
        "gpio": 0,
        "level": false,
        "ms": 100
      },
      "result": {}
    }
  ]
}
