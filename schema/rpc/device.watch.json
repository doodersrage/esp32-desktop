{
  "method": "device.watch",
  "description": "Like device.list, then keep the caller informed: a device.changed event with the full list follows every time a serial port appears or disappears. Stop it with core.unsubscribe.",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "all": {
        "type": "boolean",
        "description": "Include ports that are not USB, such as built-in /dev/ttyS*. Default false."
      }
    },
    "additionalProperties": false
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "subscription",
      "ports"
    ],
    "properties": {
      "subscription": {
        "type": "integer",
        "minimum": 1
      },
      "ports": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "path",
            "kind",
            "bridge",
            "chips",
            "access"
          ],
          "properties": {
            "path": {
              "type": "string",
              "description": "Device node, e.g. /dev/ttyUSB0."
            },
            "kind": {
              "enum": [
                "usb",
                "pci",
                "bluetooth",
                "other"
              ]
            },
            "usb": {
              "type": "object",
              "required": [
                "vid",
                "pid"
              ],
              "properties": {
                "vid": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                },
                "pid": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 65535
                },
                "serial": {
                  "type": "string"
                },
                "manufacturer": {
                  "type": "string"
                },
                "product": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "bridge": {
              "description": "What the USB device is. null when unknown.",
              "enum": [
                "cp210x",
                "ch340",
                "ch9102",
                "ftdi",
                "pl2303",
                "usb-serial-jtag",
                "usb-cdc",
                null
              ]
            },
            "chips": {
              "description": "Chips this port could belong to, as esp32bench.dev chip ids. Empty when the USB IDs do not say.",
              "type": "array",
              "items": {
                "enum": [
                  "esp32",
                  "esp32s2",
                  "esp32s3",
                  "esp32c3",
                  "esp32c6"
                ]
              }
            },
            "access": {
              "description": "Whether this user can open the port. 'denied' usually means the udev rule or the uucp group is missing.",
              "enum": [
                "ok",
                "denied"
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "advice": {
        "description": "Why a board may be missing or unusable, for the app to explain in its own words. Empty when there is nothing to say. Kinds: data-cable (no port at all; a charge-only cable shows none), install-driver (macOS and Windows: a CH340 or CP210x board may need its maker's driver), bridge-without-port (a USB serial chip is plugged in but no driver gave it a port; on Linux often brltty), serial-access (a port this user may not open). Since protocol 0.25.",
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "enum": [
                "data-cable",
                "install-driver",
                "bridge-without-port",
                "serial-access"
              ]
            },
            "bridge": {
              "description": "bridge-without-port: which chip.",
              "enum": [
                "cp210x",
                "ch340",
                "ch9102",
                "ftdi",
                "pl2303",
                "usb-serial-jtag"
              ]
            }
          },
          "additionalProperties": false
        }
      }
    },
    "additionalProperties": false
  },
  "errors": [
    -32003
  ],
  "events": [
    "device.changed"
  ],
  "examples": [
    {
      "params": {},
      "result": {
        "subscription": 1,
        "ports": [
          {
            "path": "/dev/ttyACM0",
            "kind": "usb",
            "usb": {
              "vid": 12346,
              "pid": 4097,
              "serial": "F4:12:FA:00:11:22",
              "manufacturer": "Espressif",
              "product": "USB JTAG/serial debug unit"
            },
            "bridge": "usb-serial-jtag",
            "chips": [
              "esp32s3",
              "esp32c3",
              "esp32c6"
            ],
            "access": "ok"
          }
        ]
      }
    }
  ]
}
