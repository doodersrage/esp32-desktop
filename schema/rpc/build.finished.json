{
  "event": "build.finished",
  "description": "The end of a build.start job. Sent once, unless the job was cancelled.",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "subscription",
      "ok"
    ],
    "additionalProperties": false,
    "properties": {
      "subscription": {
        "type": "integer",
        "minimum": 1
      },
      "ok": {
        "type": "boolean"
      },
      "image": {
        "type": "string",
        "description": "Merged flash image, when ok."
      },
      "elf": {
        "type": "string",
        "description": "ELF with symbols, when ok."
      },
      "error": {
        "type": "string",
        "description": "What went wrong, when not ok."
      },
      "firstError": {
        "type": "object",
        "description": "Since protocol 0.26: the first compiler or linker error in the log, when the build failed and one was printed.",
        "required": [
          "file",
          "line",
          "message"
        ],
        "additionalProperties": false,
        "properties": {
          "file": {
            "type": "string",
            "description": "Relative to a local project's folder, else the file's name."
          },
          "path": {
            "type": "string",
            "description": "The file, for opening it: only for a file inside a local project."
          },
          "line": {
            "type": "integer",
            "minimum": 0
          },
          "column": {
            "type": "integer",
            "minimum": 0
          },
          "message": {
            "type": "string"
          }
        }
      },
      "size": {
        "type": "object",
        "description": "Since protocol 0.30: how much of the board an Arduino build takes, from arduino-cli's size lines (bytes).",
        "required": [
          "flash",
          "flashMax"
        ],
        "additionalProperties": false,
        "properties": {
          "flash": {
            "type": "integer",
            "minimum": 0
          },
          "flashMax": {
            "type": "integer",
            "minimum": 1
          },
          "ram": {
            "type": "integer",
            "minimum": 0
          },
          "ramMax": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "seconds": {
        "type": "number",
        "minimum": 0,
        "description": "Since protocol 0.34: how long the build took, to a tenth of a second, not counting a wait for another build to finish."
      }
    }
  },
  "examples": [
    {
      "params": {
        "subscription": 7,
        "ok": true,
        "image": "/home/u/.cache/esp32bench/builds/blink/esp32/out/blink.ino.merged.bin",
        "elf": "/home/u/.cache/esp32bench/builds/blink/esp32/out/blink.ino.elf"
      }
    },
    {
      "params": {
        "subscription": 7,
        "ok": false,
        "error": "compiling failed (exit status: 1)"
      }
    },
    {
      "params": {
        "subscription": 3,
        "ok": false,
        "error": "arduino-cli compile failed (exit status 1)",
        "firstError": {
          "file": "blink.ino",
          "line": 12,
          "column": 3,
          "message": "'ledd' was not declared in this scope"
        }
      }
    }
  ]
}
