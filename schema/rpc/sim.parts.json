{
  "event": "sim.parts",
  "description": "Parts whose state changed: each part's whole state as its model defines it (an LED's on, an RGB LED's red, green and blue, ...), with `on` repeated at the top for parts that have it; or the part's `error` when its script failed or a control was refused. Every part once when the simulation starts, then changes, batched like sim.pins.",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "subscription",
      "parts"
    ],
    "additionalProperties": false,
    "properties": {
      "subscription": {
        "type": "integer",
        "minimum": 1
      },
      "parts": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": [
            "id"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string"
            },
            "on": {
              "type": "boolean"
            },
            "state": {
              "type": "object"
            },
            "error": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "examples": [
    {
      "params": {
        "subscription": 5,
        "parts": [
          {
            "id": "status-led",
            "on": true,
            "state": {
              "on": true
            }
          },
          {
            "id": "mood",
            "state": {
              "red": true,
              "green": false,
              "blue": true
            }
          }
        ]
      }
    }
  ]
}
