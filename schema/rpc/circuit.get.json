{
  "method": "circuit.get",
  "description": "The virtual parts placed on a project's board in the app (schema/circuit/v1.schema.json). An empty circuit if none were placed.",
  "params": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "project",
      "board"
    ],
    "additionalProperties": false,
    "properties": {
      "project": {
        "type": "string"
      },
      "board": {
        "type": "string"
      }
    }
  },
  "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "required": [
      "circuit"
    ],
    "additionalProperties": false,
    "properties": {
      "circuit": {
        "description": "Virtual parts placed on one project's board for the simulator. Version 1.x. Saved by the desktop app per project and board; designed so the project manifest can carry the same data later. Pins are GPIO numbers. Firmware-level: an LED is lit when its pin drives it; no electrical behaviour is modelled.",
        "type": "object",
        "required": [
          "schemaVersion",
          "parts"
        ],
        "additionalProperties": false,
        "properties": {
          "schemaVersion": {
            "type": "string",
            "pattern": "^1\\.[0-9]+\\.[0-9]+$"
          },
          "parts": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "required": [
                "id",
                "kind",
                "pin"
              ],
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z0-9-]{1,32}$",
                  "description": "Unique within the circuit."
                },
                "kind": {
                  "enum": [
                    "led",
                    "button"
                  ],
                  "description": "led: lit while its pin is an output at its active level. button: drives its pin to its active level while pressed, and to the other level otherwise (a pull-up or pull-down)."
                },
                "pin": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 48,
                  "description": "GPIO number."
                },
                "activeLow": {
                  "type": "boolean",
                  "default": false,
                  "description": "Active when the pin is low: an LED wired to 3V3, or a button to GND with a pull-up (INPUT_PULLUP)."
                },
                "label": {
                  "type": "string",
                  "maxLength": 40
                }
              }
            }
          }
        }
      }
    }
  },
  "errors": [
    -32602,
    -32000
  ],
  "examples": [
    {
      "params": {
        "project": "blink",
        "board": "esp32"
      },
      "result": {
        "circuit": {
          "schemaVersion": "1.0.0",
          "parts": [
            {
              "id": "status-led",
              "kind": "led",
              "pin": 2,
              "label": "Status LED"
            },
            {
              "id": "boot",
              "kind": "button",
              "pin": 0,
              "activeLow": true,
              "label": "BOOT button"
            }
          ]
        }
      }
    }
  ]
}
