# Maintainer: esp32bench maintainers <https://github.com/doodersrage/esp32-desktop>

pkgname=esp32bench-bin
pkgver=0.1.2
pkgrel=1
pkgdesc='ESP32 workbench and simulator: build, flash, monitor and simulate ESP32 projects (prebuilt)'
arch=('x86_64')
url='https://github.com/doodersrage/esp32-desktop'
license=('GPL-2.0-or-later')
depends=(
  'glibc'
  'hicolor-icon-theme'
  'libgcc'
  'libstdc++'
  'qt6-base'
  'qt6-svg'        # the app icon: a plugin Qt loads at run time, so namcap cannot see it
  'systemd-libs'   # libudev: board detection and hotplug
)
optdepends=(
  'arduino-cli: build Arduino sketches from the project library'
  # lcgamboa's QEMU fork, the simulator, is built from source by the app's setup step:
  'git: build the simulator (lcgamboa QEMU)'
  'gcc: build the simulator (lcgamboa QEMU)'
  'make: build the simulator (lcgamboa QEMU)'
  'ninja: build the simulator (lcgamboa QEMU)'
  'pkgconf: build the simulator (lcgamboa QEMU)'
  'python: build the simulator (lcgamboa QEMU)'
  'perl: build the simulator (lcgamboa QEMU)'
  'glib2: build and run the simulator'
  'pixman: build and run the simulator'
  'libgcrypt: build and run the simulator'
  'libslirp: build and run the simulator'
)
provides=('esp32bench')
conflicts=('esp32bench')
# Built on Arch from the v$pkgver tag: the same files the esp32bench-git package installs.
source=("$url/releases/download/v$pkgver/esp32bench-$pkgver-$CARCH.tar.gz")
sha256sums=('e4624c3167d32d106b6eb2f340fe79a75b6f735847e5e141443f5b8749cf84b9')

package() {
  cd "esp32bench-$pkgver-$CARCH"
  cp -a usr "$pkgdir/"
}
