new file mode 100644
index 0000000..01e6880
--- /dev/null
+++ b/include/hw/misc/esp32bench_rmt.h
@@ -0,0 +1,42 @@
+/*
+ * ESP32-C3 and ESP32-S3 RMT transmitter, for esp32bench
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+#pragma once
+
+#include "hw/sysbus.h"
+#include "qemu/timer.h"
+
+#define TYPE_ESP32BENCH_RMT "misc.esp32bench.rmt"
+OBJECT_DECLARE_SIMPLE_TYPE(Esp32BenchRmtState, ESP32BENCH_RMT)
+
+#define ESP32BENCH_RMT_MAX_TX      4
+#define ESP32BENCH_RMT_MAX_CH      8
+#define ESP32BENCH_RMT_BLOCK_WORDS 48
+#define ESP32BENCH_RMT_REG_WORDS   (0x100 / 4)
+
+typedef struct Esp32BenchRmtTx {
+    Esp32BenchRmtState *rmt;
+    int index;
+    QEMUTimer timer;
+    bool busy;
+    bool held;        /* waiting for the driver to take a threshold interrupt */
+    uint32_t pos;     /* symbols read since the start */
+    uint32_t since_thr;
+    uint32_t loops;
+} Esp32BenchRmtTx;
+
+struct Esp32BenchRmtState {
+    SysBusDevice parent_obj;
+    MemoryRegion iomem;
+    qemu_irq irq;
+    uint32_t tx_channels;   /* 2 on the C3, 4 on the S3: picks the register layout */
+    uint32_t regs[ESP32BENCH_RMT_REG_WORDS];
+    uint32_t mem[ESP32BENCH_RMT_MAX_CH * ESP32BENCH_RMT_BLOCK_WORDS];
+    uint32_t int_raw;
+    uint32_t int_ena;
+    Esp32BenchRmtTx tx[ESP32BENCH_RMT_MAX_TX];
+};
