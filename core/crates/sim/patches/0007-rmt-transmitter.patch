rmt: WS2812 writes finish on the ESP32, C3 and S3

ESP-IDF 5's RMT driver (Arduino's rmtWrite, Adafruit_NeoPixel, the C3
DevKitM's on-board RGB LED) waited forever for its first transmission to
end, so the library's NeoPixel sketches stopped at their first LED write.

ESP32 (hw/ssi/esp32_rmt.c, Espressif's model as lcgamboa extended it):
the model held data back while any threshold or end bit was raised, even
one whose interrupt was off. The driver turns the threshold interrupt off
when it has encoded everything, without clearing the bit, so nothing ever
went on. Now only an enabled interrupt holds data back, and turning it off
lets held data go. The interrupt line follows INT_RAW & INT_ENA (it was
lowered only by INT_CLR); channels other than 0 read their own memory
block (the index wrapped to channel 0's); and transmission ends at a
symbol with a zero duration in either half, whatever its level bits.

C3 and S3: neither had an RMT model (an unimplemented-device stub), so
hw/misc/esp32bench_rmt.c is new. It models the transmit side the driver
uses: channel registers (TX_START, CONF_UPDATE and the reset bits clear
themselves), RMT memory, the threshold interrupt every TX_LIM symbols,
the end interrupt, loop mode with its count, TX_STOP, and symbol timing
from the channel's clock. Nothing is output and receive channels only
keep their registers. Register layouts from ESP-IDF's rmt_struct.h.

Written for esp32bench (GPL-2.0-or-later). Changes Espressif's
hw/ssi/esp32_rmt.c (Copyright (c) 2019 Espressif Systems (Shanghai) Co.
Ltd., GPL-2.0-or-later, notice kept), lcgamboa's hw/riscv/esp32c3_picsimlab.c,
Espressif's hw/xtensa/esp32s3.c and hw/misc/meson.build. Applied by
esp32bench (core/crates/sim/src/lcgamboa.rs) to lcgamboa/qemu at
885a6e7061fb70fac78a074a719423810bc19a17, after patch 0006.

diff --git a/hw/misc/esp32bench_rmt.c b/hw/misc/esp32bench_rmt.c
new file mode 100644
index 0000000..07851eb
--- /dev/null
+++ b/hw/misc/esp32bench_rmt.c
@@ -0,0 +1,346 @@
+/*
+ * ESP32-C3 and ESP32-S3 RMT transmitter, for esp32bench
+ *
+ * Neither chip had an RMT model in this fork, so ESP-IDF's RMT driver waited
+ * forever for its first transmission to end: every WS2812 (NeoPixel) write, and
+ * the C3 DevKitM's on-board RGB LED, stopped the sketch. This models what the
+ * driver's transmit side relies on: the channel registers, RMT memory, the
+ * threshold interrupt every TX_LIM symbols (the driver refills memory on it),
+ * the end interrupt at a symbol with a zero duration, loop mode with its count,
+ * and TX_STOP. Symbols take the time their durations say at the channel's clock.
+ * Nothing is output; receive channels only keep their registers.
+ *
+ * Register layouts are from ESP-IDF's soc/esp32c3 and soc/esp32s3 rmt_struct.h.
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 or
+ * (at your option) any later version.
+ */
+
+#include "qemu/osdep.h"
+#include "qemu/module.h"
+#include "qapi/error.h"
+#include "hw/irq.h"
+#include "hw/qdev-properties.h"
+#include "hw/misc/esp32bench_rmt.h"
+
+/* Bits of a transmit channel's CONF0. */
+#define CONF_TX_START    (1u << 0)
+#define CONF_MEM_RD_RST  (1u << 1)
+#define CONF_MEM_RST     (1u << 2)
+#define CONF_CONTI       (1u << 3)
+#define CONF_TX_STOP     (1u << 7)
+/* Then the divider (8..15) and MEM_SIZE from bit 16: 3 bits on the C3, 4 on the S3,
+ * which moves AFIFO_RST and CONF_UPDATE up by one on the S3. */
+#define CONF_SELF_CLEAR(l) (CONF_TX_START | CONF_MEM_RD_RST | CONF_MEM_RST | CONF_TX_STOP | \
+                            (3u << (19 + (l)->mem_size_bits)))
+
+/* Bits of a transmit channel's TX_LIM. */
+#define LIM_LIMIT(v)        ((v) & 0x1ff)
+#define LIM_LOOP_NUM(v)     (((v) >> 9) & 0x3ff)
+#define LIM_LOOP_CNT_EN     (1u << 19)
+#define LIM_LOOP_CNT_RESET  (1u << 20)
+
+/* Interrupt bits, the same on both chips for transmit channel n. */
+#define INT_TX_END(n)   (1u << (n))
+#define INT_TX_THR(n)   (1u << ((n) + 8))
+#define INT_TX_LOOP(n)  (1u << ((n) + 12))
+
+typedef struct Layout {
+    hwaddr conf;      /* transmit channels' CONF0, 4 bytes apart */
+    hwaddr int_raw;   /* INT_RAW, then INT_ST, INT_ENA, INT_CLR */
+    hwaddr tx_lim;    /* transmit channels' TX_LIM */
+    hwaddr sys_conf;
+    hwaddr mem;       /* RMT memory */
+    unsigned channels;
+    unsigned mem_size_bits;
+} Layout;
+
+static const Layout C3 = { 0x10, 0x38, 0x58, 0x68, 0x400, 4, 3 };
+static const Layout S3 = { 0x20, 0x70, 0xA0, 0xC0, 0x800, 8, 4 };
+
+static const Layout *layout(Esp32BenchRmtState *s)
+{
+    return s->tx_channels == 4 ? &S3 : &C3;
+}
+
+static uint32_t reg(Esp32BenchRmtState *s, hwaddr addr)
+{
+    return s->regs[addr / 4];
+}
+
+static void update_irq(Esp32BenchRmtState *s)
+{
+    qemu_set_irq(s->irq, (s->int_raw & s->int_ena) != 0);
+}
+
+/* Nanoseconds per tick of channel n: the group clock, its divider, the channel's. */
+static uint64_t tick_ns(Esp32BenchRmtState *s, int n)
+{
+    const Layout *l = layout(s);
+    uint32_t sys = reg(s, l->sys_conf);
+    uint32_t sel = (sys >> 24) & 3;           /* 1 APB 80 MHz, 2 RC_FAST, 3 XTAL 40 MHz */
+    uint64_t src_ps = sel == 3 ? 25000 : sel == 2 ? 57143 : 12500;
+    uint64_t group_div = ((sys >> 4) & 0xff) + 1;
+    uint64_t div = (reg(s, l->conf + 4 * n) >> 8) & 0xff;
+    if (div == 0) {
+        div = 256;
+    }
+    return src_ps * group_div * div / 1000;
+}
+
+static void schedule(Esp32BenchRmtTx *t, uint64_t ns)
+{
+    if (ns < 1000) {
+        ns = 1000;
+    }
+    timer_mod(&t->timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + ns);
+}
+
+static void finish(Esp32BenchRmtTx *t)
+{
+    t->busy = false;
+    t->held = false;
+    timer_del(&t->timer);
+}
+
+/* Read symbols until the next threshold, the end, or a batch's worth. */
+static void transmit(void *opaque)
+{
+    Esp32BenchRmtTx *t = opaque;
+    Esp32BenchRmtState *s = t->rmt;
+    const Layout *l = layout(s);
+    int n = t->index;
+    uint32_t conf = reg(s, l->conf + 4 * n);
+    uint32_t lim_reg = reg(s, l->tx_lim + 4 * n);
+    uint32_t blocks = (conf >> 16) & ((1u << l->mem_size_bits) - 1);
+    uint32_t words = (blocks ? blocks : 1) * ESP32BENCH_RMT_BLOCK_WORDS;
+    uint32_t base = n * ESP32BENCH_RMT_BLOCK_WORDS;
+    uint32_t limit = LIM_LIMIT(lim_reg);
+    uint64_t ticks = 0;
+
+    if (!t->busy) {
+        return;
+    }
+    /* The model reads memory far faster than the guest refills it, so it waits
+     * while the driver has a threshold interrupt to take. A real channel would not,
+     * but the driver keeps up with it there. */
+    if (s->int_raw & s->int_ena & INT_TX_THR(n)) {
+        t->held = true;
+        return;
+    }
+    t->held = false;
+
+    for (uint32_t i = 0; i < words; i++) {
+        uint32_t v = s->mem[(base + t->pos % words) % ARRAY_SIZE(s->mem)];
+        uint32_t d0 = v & 0x7fff, d1 = (v >> 16) & 0x7fff;
+        ticks += d0 + d1;
+        if (d0 == 0 || d1 == 0) {
+            /* The end marker: a zero duration in either half. */
+            t->pos = 0;
+            t->since_thr = 0;
+            if (conf & CONF_CONTI) {
+                t->loops++;
+                if ((lim_reg & LIM_LOOP_CNT_EN) && t->loops >= LIM_LOOP_NUM(lim_reg)) {
+                    s->int_raw |= INT_TX_LOOP(n);
+                    t->loops = 0;
+                    update_irq(s);
+                    /* The S3 stops by itself when LOOP_STOP_EN (bit 21) is set;
+                     * otherwise the driver stops the channel on this interrupt. */
+                    if (l == &S3 && (lim_reg & (1u << 21))) {
+                        finish(t);
+                        s->int_raw |= INT_TX_END(n);
+                        update_irq(s);
+                        return;
+                    }
+                }
+                schedule(t, ticks * tick_ns(s, n));
+                return;
+            }
+            finish(t);
+            s->int_raw |= INT_TX_END(n);
+            update_irq(s);
+            return;
+        }
+        t->pos++;
+        t->since_thr++;
+        if (limit && t->since_thr >= limit) {
+            t->since_thr = 0;
+            s->int_raw |= INT_TX_THR(n);
+            update_irq(s);
+            break;
+        }
+    }
+    schedule(t, ticks * tick_ns(s, n));
+}
+
+/* Channels held for a threshold interrupt go on once it is cleared or turned off. */
+static void resume_held(Esp32BenchRmtState *s)
+{
+    for (int n = 0; n < s->tx_channels; n++) {
+        if (s->tx[n].held && !(s->int_raw & s->int_ena & INT_TX_THR(n))) {
+            s->tx[n].held = false;
+            schedule(&s->tx[n], 0);
+        }
+    }
+}
+
+static uint64_t esp32bench_rmt_read(void *opaque, hwaddr addr, unsigned int size)
+{
+    Esp32BenchRmtState *s = opaque;
+    const Layout *l = layout(s);
+
+    if (addr >= l->mem) {
+        hwaddr i = (addr - l->mem) / 4;
+        return i < l->channels * ESP32BENCH_RMT_BLOCK_WORDS ? s->mem[i] : 0;
+    }
+    if (addr == l->int_raw) {
+        return s->int_raw;
+    }
+    if (addr == l->int_raw + 4) {
+        return s->int_raw & s->int_ena;
+    }
+    if (addr == l->int_raw + 8) {
+        return s->int_ena;
+    }
+    if (addr == l->int_raw + 12) {
+        return 0;
+    }
+    return addr < sizeof(s->regs) ? reg(s, addr) : 0;
+}
+
+static void esp32bench_rmt_write(void *opaque, hwaddr addr, uint64_t value, unsigned int size)
+{
+    Esp32BenchRmtState *s = opaque;
+    const Layout *l = layout(s);
+
+    if (addr >= l->mem) {
+        hwaddr i = (addr - l->mem) / 4;
+        if (i < l->channels * ESP32BENCH_RMT_BLOCK_WORDS) {
+            s->mem[i] = value;
+        }
+        return;
+    }
+    if (addr == l->int_raw + 8) {
+        s->int_ena = value;
+        update_irq(s);
+        resume_held(s);
+        return;
+    }
+    if (addr == l->int_raw + 12) {
+        s->int_raw &= ~value;
+        update_irq(s);
+        resume_held(s);
+        return;
+    }
+    if (addr == l->int_raw || addr == l->int_raw + 4 || addr >= sizeof(s->regs)) {
+        return;
+    }
+    if (addr >= l->conf && addr < l->conf + 4 * s->tx_channels) {
+        Esp32BenchRmtTx *t = &s->tx[(addr - l->conf) / 4];
+        s->regs[addr / 4] = value & ~CONF_SELF_CLEAR(l);
+        if (value & (CONF_MEM_RD_RST | CONF_MEM_RST)) {
+            t->pos = 0;
+            t->since_thr = 0;
+        }
+        if (value & CONF_TX_STOP) {
+            finish(t);
+        }
+        if (value & CONF_TX_START) {
+            t->busy = true;
+            t->held = false;
+            t->pos = 0;
+            t->since_thr = 0;
+            t->loops = 0;
+            schedule(t, 0);
+        }
+        return;
+    }
+    if (addr >= l->tx_lim && addr < l->tx_lim + 4 * s->tx_channels) {
+        if (value & LIM_LOOP_CNT_RESET) {
+            s->tx[(addr - l->tx_lim) / 4].loops = 0;
+        }
+        s->regs[addr / 4] = value & ~LIM_LOOP_CNT_RESET;
+        return;
+    }
+    s->regs[addr / 4] = value;
+}
+
+static const MemoryRegionOps esp32bench_rmt_ops = {
+    .read = esp32bench_rmt_read,
+    .write = esp32bench_rmt_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid.min_access_size = 4,
+    .valid.max_access_size = 4,
+};
+
+static void esp32bench_rmt_reset(DeviceState *dev)
+{
+    Esp32BenchRmtState *s = ESP32BENCH_RMT(dev);
+
+    for (int n = 0; n < ESP32BENCH_RMT_MAX_TX; n++) {
+        finish(&s->tx[n]);
+        s->tx[n].pos = 0;
+        s->tx[n].since_thr = 0;
+        s->tx[n].loops = 0;
+    }
+    memset(s->regs, 0, sizeof(s->regs));
+    memset(s->mem, 0, sizeof(s->mem));
+    s->int_raw = 0;
+    s->int_ena = 0;
+    qemu_irq_lower(s->irq);
+}
+
+static void esp32bench_rmt_realize(DeviceState *dev, Error **errp)
+{
+    Esp32BenchRmtState *s = ESP32BENCH_RMT(dev);
+
+    if (s->tx_channels != 2 && s->tx_channels != 4) {
+        error_setg(errp, "esp32bench.rmt: tx-channels must be 2 (C3) or 4 (S3)");
+        return;
+    }
+    for (int n = 0; n < ESP32BENCH_RMT_MAX_TX; n++) {
+        s->tx[n].rmt = s;
+        s->tx[n].index = n;
+        timer_init_ns(&s->tx[n].timer, QEMU_CLOCK_VIRTUAL, transmit, &s->tx[n]);
+    }
+}
+
+static void esp32bench_rmt_init(Object *obj)
+{
+    Esp32BenchRmtState *s = ESP32BENCH_RMT(obj);
+    SysBusDevice *sbd = SYS_BUS_DEVICE(obj);
+
+    memory_region_init_io(&s->iomem, obj, &esp32bench_rmt_ops, s, TYPE_ESP32BENCH_RMT, 0x1000);
+    sysbus_init_mmio(sbd, &s->iomem);
+    sysbus_init_irq(sbd, &s->irq);
+}
+
+static Property esp32bench_rmt_properties[] = {
+    DEFINE_PROP_UINT32("tx-channels", Esp32BenchRmtState, tx_channels, 2),
+    DEFINE_PROP_END_OF_LIST(),
+};
+
+static void esp32bench_rmt_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+
+    dc->realize = esp32bench_rmt_realize;
+    device_class_set_legacy_reset(dc, esp32bench_rmt_reset);
+    device_class_set_props(dc, esp32bench_rmt_properties);
+}
+
+static const TypeInfo esp32bench_rmt_info = {
+    .name = TYPE_ESP32BENCH_RMT,
+    .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(Esp32BenchRmtState),
+    .instance_init = esp32bench_rmt_init,
+    .class_init = esp32bench_rmt_class_init,
+};
+
+static void esp32bench_rmt_register_types(void)
+{
+    type_register_static(&esp32bench_rmt_info);
+}
+
+type_init(esp32bench_rmt_register_types)
