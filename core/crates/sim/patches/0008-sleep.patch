+/* esp32bench: sleep. ESP-IDF enters sleep by setting STATE0's SLEEP_EN, then spins
+ * until the chip powers down (deep sleep) or RTC_CNTL raises SLP_WAKEUP (light sleep).
+ * Unmodelled, deep sleep spun until a watchdog reset the chip, with the reset reason
+ * and RTC memory of a watchdog reset, and light sleep never returned. Here deep sleep
+ * holds both CPUs and resets the digital domain, which stops the app's watchdogs
+ * (RTC memory and RTC registers are kept). When the wake-up timer fires, the digital
+ * domain is reset again, as powering it up does (the flash boot watchdog starts
+ * afresh), with reset reason DEEPSLEEP_RESET, and the SoC lets the CPUs run once that
+ * reset is done (esp32bench_rtc_cntl_reset_done). Light sleep raises SLP_WAKEUP.
+ * Only the timer wakes the chip: GPIO, touch and ULP wake-ups are not modelled. */
+#define ESP32BENCH_TIMER_TRIG_EN  (1u << 3)
+
+static uint64_t esp32bench_rtc_ticks(Esp32RtcCntlState *s)
+{
+    return muldiv64(qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) - s->time_base_ns,
+                    s->rtc_slowclk_freq, NANOSECONDS_PER_SECOND);
+}
+
+static void esp32bench_update_irq(Esp32RtcCntlState *s)
+{
+    qemu_set_irq(s->irq, (s->esp32bench_int_raw & s->esp32bench_int_ena) != 0);
+}
+
+static void esp32bench_sleep(Esp32RtcCntlState *s)
+{
+    uint32_t wake_ena = FIELD_EX32(s->esp32bench_wakeup_state, RTC_CNTL_WAKEUP_STATE, WAKEUP_ENA);
+    bool deep = FIELD_EX32(s->esp32bench_dig_pwc, RTC_CNTL_DIG_PWC, DG_WRAP_PD_EN);
+
+    if (wake_ena & ESP32BENCH_TIMER_TRIG_EN) {
+        uint64_t target = s->esp32bench_slp_timer[0] |
+                          ((uint64_t) (s->esp32bench_slp_timer[1] & 0xffff) << 32);
+        uint64_t now = esp32bench_rtc_ticks(s);
+        uint64_t ns = target > now ? muldiv64(target - now, NANOSECONDS_PER_SECOND,
+                                              s->rtc_slowclk_freq) : 0;
+        timer_mod(&s->esp32bench_wake_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + ns);
+    }
+    if (deep) {
+        s->esp32bench_deep_sleep = true;
+        for (int i = 0; i < ESP32_CPU_COUNT; ++i) {
+            s->reset_cause[i] = ESP32_DEEPSLEEP_RESET;
+            s->cpu_stall_state[i] = true;
+            qemu_set_irq(s->cpu_stall_req[i], 1);
+        }
+        qemu_irq_pulse(s->dig_reset_req);
+    }
+}
+
+static void esp32bench_wake(void *opaque)
+{
+    Esp32RtcCntlState *s = opaque;
+
+    s->esp32bench_wakeup_state = FIELD_DP32(s->esp32bench_wakeup_state, RTC_CNTL_WAKEUP_STATE,
+                                            WAKEUP_CAUSE, ESP32BENCH_TIMER_TRIG_EN);
+    if (s->esp32bench_deep_sleep) {
+        /* Waking is a reset of the digital domain, as on the chip: the flash boot
+         * watchdog starts afresh. The CPUs run once it is done. */
+        for (int i = 0; i < ESP32_CPU_COUNT; ++i) {
+            s->reset_cause[i] = ESP32_DEEPSLEEP_RESET;
+        }
+        s->esp32bench_wake_pending = true;
+        qemu_irq_pulse(s->dig_reset_req);
+    } else {
+        s->esp32bench_int_raw |= R_RTC_CNTL_INT_SLP_WAKEUP_MASK;
+        esp32bench_update_irq(s);
+    }
+}
+
+void esp32bench_rtc_cntl_reset_done(Esp32RtcCntlState *s)
+{
+    if (s->esp32bench_wake_pending) {
+        s->esp32bench_wake_pending = false;
+        s->esp32bench_deep_sleep = false;
+        esp32_rtc_update_cpu_stall(s);
+    }
+}
