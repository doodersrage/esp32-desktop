+/* esp32bench: RTC time and sleep. The model had neither: RTC time read 0, and
+ * ESP-IDF's sleep code (which sets STATE0's SLEEP_EN, then spins until the chip
+ * powers down or RTC_CNTL raises SLP_WAKEUP) spun until the interrupt watchdog
+ * fired. Here RTC time counts at the slow clock; deep sleep resets the chip with
+ * reset reason DEEPSLEEP_RESET (which stops its watchdogs; RTC memory and these
+ * registers are kept), holds the CPU halted until the wake-up timer fires, then
+ * lets it boot; light sleep raises SLP_WAKEUP. Only the timer wakes the chip: GPIO
+ * and other wake-ups are not modelled. */
+#define ESP32BENCH_TIMER_TRIG_EN  (1u << 3)
+
+static uint32_t esp32bench_slowclk_hz(ESP32C3RtcCntlState *s)
+{
+    switch (FIELD_EX32(s->esp32bench_clk_conf, RTC_CNTL_RTC_CLK_CONF, ANA_CLK_RTC_SEL)) {
+    case 1:
+        return 32768;           /* XTAL32K */
+    case 2:
+        return 17500000 / 256;  /* RC_FAST_D256 */
+    default:
+        return 136000;          /* RC_SLOW */
+    }
+}
+
+static uint64_t esp32bench_rtc_ticks(ESP32C3RtcCntlState *s)
+{
+    return muldiv64(qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) - s->esp32bench_time_base_ns,
+                    esp32bench_slowclk_hz(s), NANOSECONDS_PER_SECOND);
+}
+
+/* The CPU stays halted across resets while this is set: a CPU reset sets halted to
+ * start_powered_off, and every interrupt source has just been reset too. */
+static void esp32bench_hold_cpu(bool hold)
+{
+    CPUState *cs = first_cpu;
+    if (!cs) {
+        return;
+    }
+    cs->start_powered_off = hold;
+    if (!hold && cs->halted) {
+        cs->halted = 0;
+        qemu_cpu_kick(cs);
+    }
+}
+
+static void esp32bench_sleep(ESP32C3RtcCntlState *s)
+{
+    uint32_t wake_ena = FIELD_EX32(s->esp32bench_wakeup_state, RTC_CNTL_RTC_WAKEUP_STATE, RTC_WAKEUP_ENA);
+    bool deep = FIELD_EX32(s->esp32bench_dig_pwc, RTC_CNTL_DIG_PWC, DG_WRAP_PD_EN);
+
+    if (wake_ena & ESP32BENCH_TIMER_TRIG_EN) {
+        uint64_t target = s->esp32bench_slp_timer[0] |
+                          ((uint64_t) (s->esp32bench_slp_timer[1] & 0xffff) << 32);
+        uint64_t now = esp32bench_rtc_ticks(s);
+        uint64_t ns = target > now ? muldiv64(target - now, NANOSECONDS_PER_SECOND,
+                                              esp32bench_slowclk_hz(s)) : 0;
+        timer_mod(&s->esp32bench_wake_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + ns);
+    }
+    if (deep) {
+        s->esp32bench_deep_sleep = true;
+        s->esp32bench_sleep_reset = true;
+        s->reason = ESP32C3_DEEPSLEEP_RESET;
+        esp32bench_hold_cpu(true);
+        qemu_irq_raise(s->cpu_reset);
+    }
+}
+
+static void esp32bench_wake(void *opaque)
+{
+    ESP32C3RtcCntlState *s = opaque;
+
+    s->esp32bench_wakeup_cause = ESP32BENCH_TIMER_TRIG_EN;
+    if (s->esp32bench_deep_sleep) {
+        s->esp32bench_deep_sleep = false;
+        esp32bench_hold_cpu(false);
+    } else {
+        s->esp32bench_int_raw |= R_RTC_CNTL_INT_RAW_RTC_SLP_WAKEUP_INT_RAW_MASK;
+    }
+}
