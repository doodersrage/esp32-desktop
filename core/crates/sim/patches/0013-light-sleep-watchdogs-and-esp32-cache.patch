+/* esp32bench: in light sleep the chip gates the APB clock the timer groups count, so
+ * their watchdogs stop: ESP-IDF sleeps with interrupts off and nothing feeds them.
+ * Counting on, the interrupt watchdog fired during any light sleep longer than its
+ * timeout. The general-purpose timers keep counting (ESP-IDF accounts for the sleep
+ * from RTC time either way). */
+static void esp32bench_timg_clock_gate(void *opaque, int n, int level)
+{
+    Esp32TimgState *s = ESP32_TIMG(opaque);
+    Esp32TimgWdtState *ws = &s->wdt;
+    uint64_t ns_now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+    if (level && !ws->esp32bench_gated) {
+        ws->count_base = esp32_timg_wdt_get_count(ws, ns_now);
+        ws->esp32bench_gated = true;
+        timer_del(&ws->stage_timer);
+    } else if (!level && ws->esp32bench_gated) {
+        ws->esp32bench_gated = false;
+        ws->ns_base = ns_now;
+        esp32_timg_wdt_arm(ws, ns_now);
+    }
+}
