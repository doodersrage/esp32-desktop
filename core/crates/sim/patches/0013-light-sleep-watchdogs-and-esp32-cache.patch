+/* esp32bench: in light sleep the chip gates the clock the timer group counts, so its
+ * watchdog stops: ESP-IDF sleeps with interrupts off and nothing feeds it. Counting
+ * on, the interrupt watchdog fired during any light sleep longer than its timeout.
+ * Timer 0 keeps counting (ESP-IDF accounts for the sleep from RTC time either way). */
+static void esp32bench_timg_clock_gate(void *opaque, int n, int level)
+{
+    ESP32C3TimgState *s = ESP32C3_TIMG(opaque);
+    ESP32C3WdtState *wdt = &s->wdt;
+    QEMUTimer *t = esp32c3_virtual_counter_get_timer(&wdt->counter);
+    const int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+
+    if (level && !wdt->esp32bench_gated) {
+        esp32c3_virtual_counter_update(&wdt->counter);
+        wdt->esp32bench_left_ns = timer_pending(t) ? MAX(timer_expire_time_ns(t) - now, 0) : -1;
+        timer_del(t);
+        wdt->esp32bench_gated = true;
+    } else if (!level && wdt->esp32bench_gated) {
+        wdt->esp32bench_gated = false;
+        esp32c3_virtual_counter_reenabled(&wdt->counter);
+        if (wdt->esp32bench_left_ns >= 0) {
+            timer_mod_ns(t, now + wdt->esp32bench_left_ns);
+        }
+    }
+}
+
