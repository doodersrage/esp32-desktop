esp32c3: LEDC registers read back what is written

The C3's LEDC model returned only the timer and channel CONF0 registers
on read. ESP-IDF's LEDC driver also reads LEDC_CONF_REG's clock source
(ledc_get_freq() aborts on 0, which stopped tone()) and each channel's
DUTY_R (ledc_get_duty asserts). Now every register reads back what was
written, LEDC_CONF_REG included, and DUTY_R reports the duty written.
The model's existing duty reporting is unchanged.

Written for esp32bench (GPL-2.0-or-later), changing lcgamboa's
hw/misc/esp32c3_ledc.c (GPL-2.0-or-later, as QEMU). Applied by esp32bench
(core/crates/sim/src/lcgamboa.rs) to lcgamboa/qemu at
885a6e7061fb70fac78a074a719423810bc19a17, after patch 0004.

diff --git a/hw/misc/esp32c3_ledc.c b/hw/misc/esp32c3_ledc.c
index 21c226b..e6b2c53 100644
--- a/hw/misc/esp32c3_ledc.c
+++ b/hw/misc/esp32c3_ledc.c
@@ -10,8 +10,14 @@
 static uint64_t esp32c3_ledc_read(void *opaque, hwaddr addr, unsigned int size)
 {
     Esp32C3LEDCState *s = ESP32C3_LEDC(opaque);
-    uint64_t r = 0;
+    /* esp32bench: by default a register reads back what was written. ESP-IDF's LEDC
+     * driver reads LEDC_CONF_REG's clock source (ledc_get_freq aborts on 0) and each
+     * channel's DUTY_R, which tone() and analogWrite() go through. */
+    uint64_t r = addr < sizeof(s->esp32bench_regs) ? s->esp32bench_regs[addr / 4] : 0;
     switch (addr) {
+    case A_LEDC_CONF_REG:
+        r = s->conf_reg;
+        break;
     case A_LEDC_TIMER0_CONF_REG ... A_LEDC_TIMER3_CONF_REG:
         r = s->timer_conf_reg[(addr - A_LEDC_TIMER0_CONF_REG) / 0x8];
         break;
@@ -55,7 +61,10 @@ static void esp32c3_ledc_write(void *opaque, hwaddr addr,
 {
     Esp32C3LEDCState *s = ESP32C3_LEDC(opaque);
     int ledn;
-    
+
+    if (addr < sizeof(s->esp32bench_regs)) {
+        s->esp32bench_regs[addr / 4] = value;
+    }
     switch (addr) {
 
     case A_LEDC_CONF_REG:
@@ -108,7 +117,9 @@ static void esp32c3_ledc_write(void *opaque, hwaddr addr,
     case A_LEDC_CH3_DUTY_REG:
     case A_LEDC_CH4_DUTY_REG:
     case A_LEDC_CH5_DUTY_REG:
-        ledn = (addr - A_LEDC_CH0_DUTY_REG) / 0x14; 
+        ledn = (addr - A_LEDC_CH0_DUTY_REG) / 0x14;
+        /* DUTY_R (8 bytes on) reports the duty in force: the 19 bits written. */
+        s->esp32bench_regs[(addr + 8) / 4] = value & 0x7FFFF;
         led_set_intensity(&s->led[ledn], esp32c3_ledc_get_percent(s, value, ledn));
         qemu_set_irq(s->ledc_sync[0], (0x5000 | (ledn << 8) | led_get_intensity(&s->led[ledn])));
         break;
diff --git a/include/hw/misc/esp32c3_ledc.h b/include/hw/misc/esp32c3_ledc.h
index b7e14b7..3ce9e94 100644
--- a/include/hw/misc/esp32c3_ledc.h
+++ b/include/hw/misc/esp32c3_ledc.h
@@ -15,6 +15,8 @@ typedef struct Esp32C3LEDCState {
     SysBusDevice parent_object;
     MemoryRegion iomem;
     uint32_t conf_reg;
+    /* esp32bench: every register as last written, so reads give it back. */
+    uint32_t esp32bench_regs[64];
     uint32_t duty_res[ESP32C3_LEDC_TIMER_CNT];
     uint32_t freq[ESP32C3_LEDC_TIMER_CNT];
     uint32_t timer_conf_reg[ESP32C3_LEDC_TIMER_CNT];
