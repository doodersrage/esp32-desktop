 typedef struct ESP32C3UsbJtagState {
     SysBusDevice parent_object;
     MemoryRegion iomem;
+    /* esp32bench: the CDC-ACM serial side */
+    CharBackend chr;
+    qemu_irq irq;
+    uint32_t int_raw;
+    uint32_t int_ena;
+    uint32_t regs[ESP32C3_JTAG_REGS_SIZE / 4];
+    uint8_t tx[ESP32C3_JTAG_FIFO];
+    uint32_t tx_len;
+    uint8_t rx[ESP32C3_JTAG_FIFO];
+    uint32_t rx_len;
+    uint32_t rx_pos;
 } ESP32C3UsbJtagState;
 
