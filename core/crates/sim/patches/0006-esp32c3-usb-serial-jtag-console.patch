@@ -11,22 +16,128 @@
 #include "qemu/log.h"
 #include "qemu/module.h"
 #include "qemu/error-report.h"
+#include "qemu/timer.h"
 #include "hw/hw.h"
+#include "hw/irq.h"
 #include "hw/sysbus.h"
+#include "hw/qdev-properties-system.h"
 #include "hw/misc/esp32c3_jtag.h"
 
+extern GMainContext *g_main_context_default_l;
+
+#define USJ_EP1             0x00
+#define USJ_EP1_CONF        0x04
+#define USJ_INT_RAW         0x08
+#define USJ_INT_ST          0x0c
+#define USJ_INT_ENA         0x10
+#define USJ_INT_CLR         0x14
+#define USJ_FRAM_NUM        0x24
+
+#define USJ_WR_DONE             (1u << 0)
+#define USJ_IN_EP_DATA_FREE     (1u << 1)
+#define USJ_OUT_EP_DATA_AVAIL   (1u << 2)
+
+#define USJ_INT_SOF             (1u << 1)
+#define USJ_INT_OUT_RECV_PKT    (1u << 2)
+#define USJ_INT_IN_EMPTY        (1u << 3)
+
+static void esp32c3_jtag_update_irq(ESP32C3UsbJtagState *s)
+{
+    qemu_set_irq(s->irq, (s->int_raw & s->int_ena) != 0);
+}
+
+/* The host takes the IN packet: send what is buffered, and the FIFO is empty again. */
+static void esp32c3_jtag_send(ESP32C3UsbJtagState *s)
+{
+    if (s->tx_len && qemu_chr_fe_backend_connected(&s->chr)) {
+        qemu_chr_fe_write_all(&s->chr, s->tx, s->tx_len);
+    }
+    s->tx_len = 0;
+    s->int_raw |= USJ_INT_IN_EMPTY;
+    esp32c3_jtag_update_irq(s);
+}
 
 static uint64_t esp32c3_jtag_read(void *opaque, hwaddr addr, unsigned int size)
 {
     ESP32C3UsbJtagState *s = ESP32C3_JTAG(opaque);
-    (void) s;
-    return 0;
+    switch (addr) {
+    case USJ_EP1: {
+        uint32_t r = 0;
+        if (s->rx_pos < s->rx_len) {
+            r = s->rx[s->rx_pos++];
+            if (s->rx_pos == s->rx_len) {
+                s->rx_pos = s->rx_len = 0;
+                qemu_chr_fe_accept_input(&s->chr);
+            }
+        }
+        return r;
+    }
+    case USJ_EP1_CONF:
+        return USJ_IN_EP_DATA_FREE
+             | (s->rx_pos < s->rx_len ? USJ_OUT_EP_DATA_AVAIL : 0);
+    case USJ_INT_RAW:
+        return s->int_raw;
+    case USJ_INT_ST:
+        return s->int_raw & s->int_ena;
+    case USJ_INT_ENA:
+        return s->int_ena;
+    case USJ_FRAM_NUM:
+        /* A full-speed host sends a start-of-frame every millisecond. */
+        return qemu_clock_get_ms(QEMU_CLOCK_VIRTUAL) & 0x7ff;
+    default:
+        return addr < ESP32C3_JTAG_REGS_SIZE ? s->regs[addr / 4] : 0;
+    }
 }
 
 static void esp32c3_jtag_write(void *opaque, hwaddr addr, uint64_t value, unsigned int size)
 {
     ESP32C3UsbJtagState *s = ESP32C3_JTAG(opaque);
-    (void) s;
+    switch (addr) {
+    case USJ_EP1:
+        s->tx[s->tx_len++] = value & 0xff;
+        /* A host drains a full FIFO without waiting for WR_DONE, so the IN side
+         * is never full. ESP-IDF mirrors its logs here (the C3's secondary
+         * console) and must never be left waiting for space. */
+        if (s->tx_len == ESP32C3_JTAG_FIFO) {
+            esp32c3_jtag_send(s);
+        }
+        break;
+    case USJ_EP1_CONF:
+        if (value & USJ_WR_DONE) {
+            esp32c3_jtag_send(s);
+        }
+        break;
+    case USJ_INT_ENA:
+        s->int_ena = value;
+        esp32c3_jtag_update_irq(s);
+        break;
+    case USJ_INT_CLR:
+        s->int_raw &= ~value;
+        esp32c3_jtag_update_irq(s);
+        break;
+    default:
+        if (addr < ESP32C3_JTAG_REGS_SIZE) {
+            s->regs[addr / 4] = value;
+        }
+        break;
+    }
+}
+
+static int esp32c3_jtag_can_receive(void *opaque)
+{
+    ESP32C3UsbJtagState *s = ESP32C3_JTAG(opaque);
+    return s->rx_len == 0 ? ESP32C3_JTAG_FIFO : 0;
+}
+
+static void esp32c3_jtag_receive(void *opaque, const uint8_t *buf, int size)
+{
+    ESP32C3UsbJtagState *s = ESP32C3_JTAG(opaque);
+    size = MIN(size, ESP32C3_JTAG_FIFO);
+    memcpy(s->rx, buf, size);
+    s->rx_len = size;
+    s->rx_pos = 0;
+    s->int_raw |= USJ_INT_OUT_RECV_PKT;
+    esp32c3_jtag_update_irq(s);
 }
 
