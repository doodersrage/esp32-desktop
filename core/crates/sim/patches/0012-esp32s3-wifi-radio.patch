 // -----------------------------------------------
 
+/* esp32bench: a Wi-Fi radio for the S3. The S3's radio blocks are the C3's generation
+ * at the C3's addresses, so lcgamboa's C3 models serve: the analog I2C master the PHY
+ * calibration polls (0x6000E000), PHYA, FE and the power manager, with the
+ * baseband registers reading all ones as on the C3, and the C3's Wi-Fi MAC with its
+ * interrupt. The MAC exists only when a session asks for the radio
+ * (-nic ...,model=esp32c3_wifi); without the analog models Wi-Fi start-up hung in
+ * the PHY's calibration (ram_read_sar2_code polling 0x6000E050). */
+static void esp32bench_s3_add_dev(MemoryRegion *sys_mem, const char *type, hwaddr base)
+{
+    DeviceState *d = qdev_new(type);
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(d), &error_fatal);
+    memory_region_add_subregion_overlap(sys_mem, base, sysbus_mmio_get_region(SYS_BUS_DEVICE(d), 0), 1);
+}
+
+static void esp32bench_s3_init_radio(Esp32s3SocState *ss, MemoryRegion *sys_mem)
+{
+    NICInfo *nd = qemu_find_nic_info(TYPE_ESP32C3_WIFI, false, NULL);
+    if (nd == NULL) {
+        return;
+    }
+    esp32bench_s3_add_dev(sys_mem, TYPE_ESP32C3_ANA, 0x6000E000);
+    esp32bench_s3_add_dev(sys_mem, TYPE_ESP32_PHYA, 0x60034000);
+    esp32bench_s3_add_dev(sys_mem, TYPE_ESP32_FE, 0x60006000);
+    esp32bench_s3_add_dev(sys_mem, TYPE_ESP32C3_PWR_MANAGER, 0x60035000);
+    create_unimplemented_device_default_value("esp32s3.fe2", 0x60005000, 0x1000, 0);
+    create_unimplemented_device_default_value("esp32s3.nrx", 0x6001C000, 0x1000, -1);
+    create_unimplemented_device_default_value("esp32s3.bb", 0x6001D000, 0x1000, -1);
+
+    DeviceState *dev = qdev_new(TYPE_ESP32C3_WIFI);
+    Esp32WifiState *wifi = ESP32C3_WIFI(dev);
+    /* The station's MAC address, from the eFuses, as the C3 machine takes it. */
+    device_cold_reset(DEVICE(&ss->efuse));
+    const uint8_t *mac = (const uint8_t *) &ss->efuse.parent.efuses.blocks.rd_mac_spi_sys_0;
+    for (int i = 0; i < 6; i++) {
+        wifi->macaddr[i] = mac[5 - i];
+    }
+    qdev_set_nic_properties(dev, nd);
+    sysbus_realize_and_unref(SYS_BUS_DEVICE(dev), &error_fatal);
+    memory_region_add_subregion_overlap(sys_mem, 0x60033000, sysbus_mmio_get_region(SYS_BUS_DEVICE(dev), 0), 1);
+    sysbus_connect_irq(SYS_BUS_DEVICE(dev), 0,
+                       qdev_get_gpio_in(DEVICE(&ss->intmatrix), ETS_WIFI_MAC_INTR_SOURCE));
+}
+
 static void esp32s3_soc_add_unimp_device(MemoryRegion *dest, const char* name, hwaddr dport_base_addr, size_t size)
 {
     create_unimplemented_device(name, dport_base_addr, size);
@@ -976,6 +1031,7 @@ static void esp32s3_machine_init(MachineState *machine)
     }
 
     esp32s3_soc_add_unimp_device(sys_mem, "esp32s3.iomux", DR_REG_IO_MUX_BASE, 0x2000);
+    esp32bench_s3_init_radio(ss, sys_mem);
 
     
     esp32s3_machine_init_sd(ss);
