+/* esp32bench: PICSimLab's host hooks on the S3, as hw/xtensa/esp32_picsimlab.c gives
+ * the ESP32: the host's callbacks see the bridged pins (the pin map it registered)
+ * change, and its qemu_picsimlab_set_pin / set_apin / get_internals reach this
+ * machine's GPIO and ADC. The callbacks and those functions live in
+ * esp32_picsimlab.c, which this library also holds; outside the library (the
+ * executable) no pin map is registered and nothing here is connected. */
+extern void (*picsimlab_write_pin)(int pin, int value);
+extern void (*picsimlab_dir_pin)(int pin, int value);
+extern const short int *esp32bench_picsimlab_pinmap(void);
+extern void (*esp32bench_set_pin_hook)(int pin, int value);
+extern void (*esp32bench_set_apin_hook)(int chn, int value);
+extern uint32_t *(*esp32bench_internals_hook)(int cfg);
+
+static Esp32s3SocState *esp32bench_s3;
+static qemu_irq esp32bench_s3_pin_in[100];
+
+static void esp32bench_s3_out(void *opaque, int n, int level)
+{
+    picsimlab_write_pin(n, level);
+}
+
+static void esp32bench_s3_dir(void *opaque, int n, int dir)
+{
+    picsimlab_dir_pin(n, dir);
+}
+
+static void esp32bench_s3_sync(void *opaque, int n, int level)
+{
+    picsimlab_dir_pin(-1, level);
+}
+
+static void esp32bench_s3_set_pin(int pin, int value)
+{
+    if (pin > 0 && pin < 100 && esp32bench_s3_pin_in[pin]) {
+        qemu_set_irq(esp32bench_s3_pin_in[pin], value ? 1 : 0);
+    }
+}
+
+static void esp32bench_s3_set_apin(int chn, int value)
+{
+    if (chn >= 0 && chn < ESP32BENCH_ADC_CHANNELS) {
+        esp32bench_adc_values[chn] = value & ESP32BENCH_MEAS_DATA;
+    }
+}
+
+/* The PICSimLab internals the host reads: as the ESP32's numbering (0 strap,
+ * 1 GPIO in_sel, 2 GPIO out_sel); the rest are not modelled on this machine. */
+static uint32_t *esp32bench_s3_internals(int cfg)
+{
+    Esp32GpioState *g = &esp32bench_s3->gpio.parent;
+    switch (cfg) {
+    case 0:
+        return &g->strap_mode;
+    case 1:
+        return g->gpio_in_sel;
+    case 2:
+        return g->gpio_out_sel;
+    default:
+        return NULL;
+    }
+}
+
+static void esp32bench_s3_wire_picsimlab(Esp32s3SocState *ss)
+{
+    const short int *pinmap = esp32bench_picsimlab_pinmap();
+    if (!pinmap) {
+        return;
+    }
+    esp32bench_s3 = ss;
+    esp32bench_set_pin_hook = esp32bench_s3_set_pin;
+    esp32bench_set_apin_hook = esp32bench_s3_set_apin;
+    esp32bench_internals_hook = esp32bench_s3_internals;
+    DeviceState *gpio = DEVICE(&ss->gpio);
+    qemu_irq *sync = qemu_allocate_irqs(esp32bench_s3_sync, NULL, 1);
+    qdev_connect_gpio_out_named(gpio, ESP32_GPIOS_SYNC, 0, sync[0]);
+    qemu_irq *dir = qemu_allocate_irqs(esp32bench_s3_dir, NULL, pinmap[0] + 1);
+    qemu_irq *out = qemu_allocate_irqs(esp32bench_s3_out, NULL, pinmap[0] + 1);
+    for (int pin = 1; pin < pinmap[0] + 1 && pin < 100; pin++) {
+        int gpio_num = pinmap[pin];
+        if (gpio_num < 0 || gpio_num >= 40) {
+            continue;
+        }
+        if (gpio_num < 32) {
+            qdev_connect_gpio_out_named(gpio, ESP32_GPIOS, gpio_num, out[pin]);
+            qdev_connect_gpio_out_named(gpio, ESP32_GPIOS_DIR, gpio_num, dir[pin]);
+        }
+        esp32bench_s3_pin_in[pin] = qdev_get_gpio_in_named(gpio, ESP32_GPIOS_IN, gpio_num);
+    }
+}
