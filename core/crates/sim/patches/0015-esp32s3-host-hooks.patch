+    /* esp32bench: the two I2C controllers, each with PICSimLab's bus device, which
+     * passes every transfer to the host (hw/i2c/picsimlab_i2c.c; its address is the
+     * bus number). Without a host it answers nothing, as an empty bus. */
+    {
