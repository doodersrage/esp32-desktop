+            sysbus_connect_irq(SYS_BUS_DEVICE(&ss->i2c[i]), 0,
+                               qdev_get_gpio_in(intmatrix_dev, irq[i]));
+            I2CBus *bus = I2C_BUS(qdev_get_child_bus(DEVICE(&ss->i2c[i]), "i2c"));
+            i2c_slave_create_simple(bus, "picsimlab_i2c", i);
+        }
