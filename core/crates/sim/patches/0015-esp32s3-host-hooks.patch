esp32s3: PICSimLab's host hooks, I2C controllers, its own GPIO registers

The S3 had no PICSimLab machine, so esp32bench ran it on the executable
with no pin, I2C or analog access. This gives the library's `esp32s3`
machine the same hooks the ESP32's has, so a host can see and drive its
pins, answer its I2C buses and set its analog inputs:

- The GPIO model now has the S3's own register map (ESP-IDF's
  soc/esp32s3 gpio_struct.h). It reused the ESP32's, whose pin,
  input-select and output-select registers are elsewhere (0x88, 0x130,
  0x530 against the S3's 0x74, 0x154, 0x554), so GPIO interrupt set-up
  and the GPIO matrix wrote the wrong registers. Bank 0 is laid out as on
  the C3; bank 1 adds OUT1, ENABLE1, IN1 and STATUS1. Interrupt status
  is per core: PCPU_INT for core 0, CPUSDIO_INT for core 1. The GPIO
  interrupt is now connected to the interrupt matrix. The shared state
  keeps 40 pins, so GPIO 40-48 are not modelled, and as on the ESP32
  only GPIO 0-31 report output changes.
- Two I2C controllers (the C3's controller model, which the S3 shares),
  each with PICSimLab's bus device, which hands every transfer to the
  host. Without a host it answers nothing, as an empty bus.
- The SENS registers' one-shot conversions (patch 0004) read the value
  the host set for the channel (qemu_picsimlab_set_apin: ADC1 channel n
  at index n, ADC2 at n + 10), else 0.
- When a host has registered a pin map, the machine connects the bridged
  pins' output and direction lines to its callbacks, and points
  qemu_picsimlab_set_pin, set_apin and get_internals (defined in
  esp32_picsimlab.c, which the same library holds) at this machine
  through three hook pointers. Without a pin map (the executable) nothing
  changes.

Written for esp32bench (GPL-2.0-or-later). Changes Espressif's
hw/gpio/esp32s3_gpio.c, include/hw/gpio/esp32_gpio.h and
hw/xtensa/esp32s3.c (Copyright (c) 2019-2023 Espressif Systems
(Shanghai) Co. Ltd., GPL-2.0-or-later) and lcgamboa's
hw/xtensa/esp32_picsimlab.c (GPL-2.0-or-later); notices kept. Applied by
esp32bench (core/crates/sim/src/lcgamboa.rs) to lcgamboa/qemu at
885a6e7061fb70fac78a074a719423810bc19a17, after patch 0014.

diff --git a/hw/gpio/esp32s3_gpio.c b/hw/gpio/esp32s3_gpio.c
index 0a0e477..e673b73 100644
--- a/hw/gpio/esp32s3_gpio.c
+++ b/hw/gpio/esp32s3_gpio.c
@@ -19,11 +19,230 @@
 #include "hw/qdev-properties.h"
 #include "hw/gpio/esp32s3_gpio.h"
 
+/*
+ * esp32bench: the S3's own register map (ESP-IDF's soc/esp32s3 gpio_struct.h). The
+ * ESP32's model it used before has the pin, input-select and output-select registers
+ * at other offsets (0x88, 0x130, 0x530), so interrupt set-up and the GPIO matrix
+ * landed in the wrong registers. Bank 0 (GPIO 0-31) is laid out as on the C3; bank 1
+ * (GPIO 32-48) adds OUT1, ENABLE1, IN1 and STATUS1. The parent's state keeps 40
+ * pins, so GPIO 40-48 are not modelled; like the ESP32's, only GPIO 0-31 report
+ * output changes.
+ *
+ * Interrupt enables in GPIO_PINn_REG: bit 13 is the PRO CPU (core 0), whose status
+ * is PCPU_INT; bit 15 is the APP CPU (core 1), whose status is CPUSDIO_INT. The
+ * parent's set_gpio() records them in gpio_acpu_int and gpio_pcpu_int.
+ */
+#define S3_PIN_BASE        0x74
+#define S3_IN_SEL_BASE     0x154
+#define S3_OUT_SEL_BASE    0x554
+#define S3_MODELLED_PINS   40
+
+static void esp32s3_gpio_clear_status(Esp32GpioState *s, uint32_t value, int bank)
+{
+    uint32_t in = bank ? s->gpio_in1 : s->gpio_in;
+    int clearirq = 1;
+    for (int i = 0; i < 32; i++) {
+        int pin = i + 32 * bank;
+        if (!((1u << i) & value) || pin >= S3_MODELLED_PINS) {
+            continue;
+        }
+        int int_type = (s->gpio_pin[pin] >> 7) & 7;
+        if ((int_type == 4 && !(in & (1u << i))) ||
+            (int_type == 5 && (in & (1u << i)))) {
+            clearirq = 0;
+        }
+    }
+    if (!clearirq) {
+        return;
+    }
+    if (bank) {
+        s->gpio_status1 &= ~value;
+        s->gpio_pcpu_int1 &= ~value;
+        s->gpio_acpu_int1 &= ~value;
+    } else {
+        s->gpio_status &= ~value;
+        s->gpio_pcpu_int &= ~value;
+        s->gpio_acpu_int &= ~value;
+    }
+    qemu_set_irq(s->irq, 0);
+}
+
+static uint64_t esp32s3_gpio_read(void *opaque, hwaddr addr, unsigned int size)
+{
+    Esp32GpioState *s = ESP32_GPIO(opaque);
+    uint64_t r = 0;
+    switch (addr) {
+    case 0x04: /* GPIO_OUT_REG */
+        r = s->gpio_out;
+        break;
+    case 0x10: /* GPIO_OUT1_REG */
+        r = s->gpio_out1;
+        break;
+    case 0x20: /* GPIO_ENABLE_REG */
+        r = s->gpio_enable;
+        break;
+    case 0x2c: /* GPIO_ENABLE1_REG */
+        r = s->gpio_enable1;
+        break;
+    case 0x38: /* GPIO_STRAP_REG */
+        r = s->strap_mode;
+        break;
+    case 0x3c: /* GPIO_IN_REG */
+        qemu_set_irq(s->gpios_sync[0], -1); /* request sync */
+        r = s->gpio_in;
+        break;
+    case 0x40: /* GPIO_IN1_REG */
+        qemu_set_irq(s->gpios_sync[0], -1);
+        r = s->gpio_in1;
+        break;
+    case 0x44: /* GPIO_STATUS_REG */
+        r = s->gpio_status;
+        break;
+    case 0x50: /* GPIO_STATUS1_REG */
+        r = s->gpio_status1;
+        break;
+    case 0x5c: /* GPIO_PCPU_INT_REG: core 0 */
+        r = s->gpio_acpu_int;
+        break;
+    case 0x64: /* GPIO_CPUSDIO_INT_REG: core 1 */
+        r = s->gpio_pcpu_int;
+        break;
+    case 0x68: /* GPIO_PCPU_INT1_REG */
+        r = s->gpio_acpu_int1;
+        break;
+    case 0x70: /* GPIO_CPUSDIO_INT1_REG */
+        r = s->gpio_pcpu_int1;
+        break;
+    default:
+        break;
+    }
+    if (addr >= S3_PIN_BASE && addr < S3_PIN_BASE + 4 * S3_MODELLED_PINS) {
+        r = s->gpio_pin[(addr - S3_PIN_BASE) / 4];
+    } else if (addr >= S3_IN_SEL_BASE && addr < S3_IN_SEL_BASE + 4 * 256) {
+        r = s->gpio_in_sel[(addr - S3_IN_SEL_BASE) / 4];
+    } else if (addr >= S3_OUT_SEL_BASE && addr < S3_OUT_SEL_BASE + 4 * S3_MODELLED_PINS) {
+        r = s->gpio_out_sel[(addr - S3_OUT_SEL_BASE) / 4];
+    }
+    return r;
+}
+
+static void esp32s3_gpio_write(void *opaque, hwaddr addr, uint64_t value,
+                               unsigned int size)
+{
+    Esp32GpioState *s = ESP32_GPIO(opaque);
+    uint32_t oldvalue = s->gpio_out;
+    uint32_t oldenable = s->gpio_enable;
+    switch (addr) {
+    case 0x04: /* GPIO_OUT_REG */
+        s->gpio_out = value;
+        break;
+    case 0x08: /* GPIO_OUT_W1TS_REG */
+        s->gpio_out |= value;
+        break;
+    case 0x0c: /* GPIO_OUT_W1TC_REG */
+        s->gpio_out &= ~value;
+        break;
+    case 0x10: /* GPIO_OUT1_REG */
+        s->gpio_out1 = value;
+        break;
+    case 0x14: /* GPIO_OUT1_W1TS_REG */
+        s->gpio_out1 |= value;
+        break;
+    case 0x18: /* GPIO_OUT1_W1TC_REG */
+        s->gpio_out1 &= ~value;
+        break;
+    case 0x20: /* GPIO_ENABLE_REG */
+        s->gpio_enable = value;
+        break;
+    case 0x24: /* GPIO_ENABLE_W1TS_REG */
+        s->gpio_enable |= value;
+        break;
+    case 0x28: /* GPIO_ENABLE_W1TC_REG */
+        s->gpio_enable &= ~value;
+        break;
+    case 0x2c: /* GPIO_ENABLE1_REG */
+        s->gpio_enable1 = value;
+        break;
+    case 0x30: /* GPIO_ENABLE1_W1TS_REG */
+        s->gpio_enable1 |= value;
+        break;
+    case 0x34: /* GPIO_ENABLE1_W1TC_REG */
+        s->gpio_enable1 &= ~value;
+        break;
+    case 0x38: /* GPIO_STRAP_REG */
+        s->strap_mode = value;
+        break;
+    case 0x44: /* GPIO_STATUS_REG */
+        s->gpio_status = value;
+        break;
+    case 0x48: /* GPIO_STATUS_W1TS_REG */
+        s->gpio_status |= value;
+        break;
+    case 0x4c: /* GPIO_STATUS_W1TC_REG */
+        esp32s3_gpio_clear_status(s, value, 0);
+        break;
+    case 0x50: /* GPIO_STATUS1_REG */
+        s->gpio_status1 = value;
+        break;
+    case 0x54: /* GPIO_STATUS1_W1TS_REG */
+        s->gpio_status1 |= value;
+        break;
+    case 0x58: /* GPIO_STATUS1_W1TC_REG */
+        esp32s3_gpio_clear_status(s, value, 1);
+        break;
+    default:
+        break;
+    }
+    if (addr >= S3_PIN_BASE && addr < S3_PIN_BASE + 4 * S3_MODELLED_PINS) {
+        s->gpio_pin[(addr - S3_PIN_BASE) / 4] = value;
+    } else if (addr >= S3_IN_SEL_BASE && addr < S3_IN_SEL_BASE + 4 * 256) {
+        int n = (addr - S3_IN_SEL_BASE) / 4;
+        s->gpio_in_sel[n] = value;
+        qemu_set_irq(s->gpios_sync[0], (0x1000 | n)); /* report in sel cfg change */
+    } else if (addr >= S3_OUT_SEL_BASE && addr < S3_OUT_SEL_BASE + 4 * S3_MODELLED_PINS) {
+        int n = (addr - S3_OUT_SEL_BASE) / 4;
+        s->gpio_out_sel[n] = value;
+        qemu_set_irq(s->gpios_sync[0], (0x2000 | n)); /* report out sel cfg change */
+    }
+
+    if (s->gpio_out != oldvalue || s->gpio_enable != oldenable) {
+        uint32_t diff = (s->gpio_out ^ oldvalue) | (s->gpio_enable ^ oldenable);
+        for (int i = 0; i < 32; i++) {
+            if ((diff & (1u << i)) && (s->gpio_enable & (1u << i))) {
+                qemu_set_irq(s->gpios[i], (s->gpio_out & (1u << i)) ? 1 : 0);
+                if (s->gpio_out & (1u << i)) {
+                    s->gpio_in |= (1u << i);
+                } else {
+                    s->gpio_in &= ~(1u << i);
+                }
+            }
+        }
+    }
+    if (s->gpio_enable != oldenable) {
+        uint32_t diff = s->gpio_enable ^ oldenable;
+        for (int i = 0; i < 32; i++) {
+            if (diff & (1u << i)) {
+                qemu_set_irq(s->gpios_dir[i], (s->gpio_enable & (1u << i)) ? 1 : 0);
+            }
+        }
+    }
+}
+
+static const MemoryRegionOps esp32s3_gpio_ops = {
+    .read = esp32s3_gpio_read,
+    .write = esp32s3_gpio_write,
+    .endianness = DEVICE_LITTLE_ENDIAN,
+};
 
 static void esp32s3_gpio_init(Object *obj)
 {
+    ESP32S3GPIOState *s = ESP32S3_GPIO(obj);
     /* Set the default value for the property */
     object_property_set_int(obj, "strap_mode", ESP32S3_STRAP_MODE_FLASH_BOOT, &error_fatal);
+    /* esp32bench: replace the parent's ESP32 register map with the S3's (the parent
+     * registered the region with the bus already; this is the same object). */
+    memory_region_init_io(&s->parent.iomem, obj, &esp32s3_gpio_ops, s, TYPE_ESP32S3_GPIO,
+                          0x1000);
 }
 
