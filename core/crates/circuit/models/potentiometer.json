{
  "schemaVersion": "1.1.0",
  "id": "potentiometer",
  "name": "Potentiometer (analog input)",
  "look": "box",
  "pins": [
    "wiper"
  ],
  "controls": [
    {
      "name": "position",
      "type": "slider",
