{
  "schemaVersion": "1.0.0",
  "id": "mpu6050",
  "name": "MPU-6050 (accelerometer, gyroscope)",
  "look": "box",
  "i2c": { "addresses": [104, 105] },
  "controls": [
    { "name": "pitch", "type": "slider", "label": "Pitch", "min": -90, "max": 90, "default": 0, "unit": "°" },
    { "name": "roll", "type": "slider", "label": "Roll", "min": -180, "max": 180, "default": 0, "unit": "°" },
    { "name": "temperature", "type": "slider", "label": "Temperature", "min": -40, "max": 85, "default": 25, "unit": "°C" }
  ],
  "state": { "pitch": 0.0, "roll": 0.0, "temperature": 25.0 },
  "script": "mpu6050.rhai"
}
